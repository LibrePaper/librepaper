# Builds the Arch package from the release .deb that sits next to this file.
# The release workflow sets pkgver. See tools/release/build-arch-package.sh.
pkgname=librepaper
pkgver=0.0.0
pkgrel=1
pkgdesc="LibrePaper desktop app, with the librepaper command line"
arch=('x86_64')
url="https://librepaper.org"
license=('MIT')
depends=('webkit2gtk-4.1' 'gtk3')
source=("librepaper_${pkgver}_amd64.deb" "LICENSE")
sha256sums=('SKIP' 'SKIP')

package() {
  bsdtar -xf data.tar.gz -C "$pkgdir"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
