{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LibrePaper",
  "version": "0.0.42",
  "identifier": "org.librepaper.desktop",
  "build": {
    "frontendDist": "./blank"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "externalBin": ["binaries/librepaper"]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["librepaper"]
      }
    }
  }
}
