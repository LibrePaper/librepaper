dist/
komodoc-data/
examples/*.html
# ...except this one, which is the hand-written HTML example: it is a source
# file that no tool renders, which is the whole point of it.
!examples/style-guide.html
examples/*_files/
examples/.calepin/
.envrc
.env

# The reader shell is built from web/ by bun and vite, and the README is
# copied in beside it: everything under src/shell is a build output that the
# binary embeds.
src/shell/
examples/.venv/
examples/__marimo__/
.claude

# Cargo build output.
target/

# The Cargo lockfile is committed: this builds a binary, not a library.
!Cargo.lock

# Installed by bun from web/bun.lock, which is committed: a lockfile is a
# build input, the tree it installs is not.
web/node_modules/

# The LaTeX distributions, mirrored locally by latex/mirror.mjs. Hundreds of
# megabytes of somebody else's release; a manifest and a script rebuild it.
latex/mirror/

# What a TeX run leaves beside a document in examples/latex. The corpus keeps
# its sources and the logs the engines produced; everything else is remade by
# `node latex/texlive.mjs`.
examples/latex/*/main.aux
examples/latex/*/main.bbl
examples/latex/*/main.blg
examples/latex/*/main.log
examples/latex/*/main.pdf
examples/latex/*/main.synctex.gz
examples/latex/*/chapters/*.aux
examples/latex/article/article.bib
