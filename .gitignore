dist/
komodoc-data/
examples/*.html
examples/*_files/
.envrc
.env

# The reader shell is built from web/ by bun and vite, and the README is
# copied in beside it: everything under web/dist is a build output that the
# binary embeds.
web/dist/
.claude

# Cargo build output.
target/

# The Cargo lockfile is committed: this builds a binary, not a library.
!Cargo.lock

# Installed by bun from web/bun.lock, which is committed: a lockfile is a
# build input, the tree it installs is not.
web/node_modules/

# The LaTeX distributions, mirrored locally by latex/tools/mirror.mjs. Hundreds of
# megabytes of somebody else's release; a manifest and a script rebuild it.
latex/mirror/

# What a TeX run leaves beside a document in latex/corpus. The corpus keeps
# its sources and the logs the engines produced; everything else is remade by
# `node latex/tools/texlive.mjs`.
latex/corpus/*/main.aux
latex/corpus/*/main.bbl
latex/corpus/*/main.blg
latex/corpus/*/main.log
latex/corpus/*/main.pdf
latex/corpus/*/main.synctex.gz
latex/corpus/*/chapters/*.aux
latex/corpus/article/article.bib

# What wrangler leaves beside deploy/latex/wrangler.toml when it deploys.
deploy/latex/.wrangler/
