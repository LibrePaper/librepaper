dist/
librepaper-data/
docs/examples/*.html
docs/examples/*_files/
.envrc
.env
deploy/.env
deploy/compose.override.yaml
deploy/librepaper.toml.candidate*
deploy/resticprofile.toml.candidate*
deploy/librepaper.candidate*
deploy/site/

# The reader shell is built from web/ by bun and vite, and the README is
# copied in beside it: everything under web/dist is a build output that the
# binary embeds.
web/dist
web/dist/
web/wasm/
.claude

# The docs site: docs/.build is the markdown rendered by
# web/tools/build-site.mjs, and docs/_site is what vite.site.config.js builds
# from it. Both are generated fresh by `make site`.
docs/.build/
docs/_site/

# Cargo build output.
target/

# The Cargo lockfile is committed: this builds a binary, not a library.
!Cargo.lock

# Installed dependencies are generated; keep manifests and lockfiles tracked.
node_modules/

# The LaTeX distribution mirror is built and published by the wasm-latex
# repository; local release payloads can be hundreds of megabytes.
tools/test/latex/mirror/

# What a TeX run leaves beside a document in tools/test/latex/corpus. The corpus keeps
# its sources and the logs the engines produced; everything else is remade by
# `node tools/test/latex/texlive.mjs`.
tools/test/latex/corpus/*/main.aux
tools/test/latex/corpus/*/main.bbl
tools/test/latex/corpus/*/main.blg
tools/test/latex/corpus/*/main.log
tools/test/latex/corpus/*/main.pdf
tools/test/latex/corpus/*/main.synctex.gz
tools/test/latex/corpus/*/chapters/*.aux
tools/test/latex/corpus/article/article.bib

# The CodeMirror binding is fetched from its fork by `node tools/assets/pins.mjs fetch`
# and verified against web/loro-codemirror.lock. The source lives in the fork, so
# there is one copy of it rather than two to keep in step.
web/vendor/loro-codemirror/
.kata.local.toml
# roborev snapshots
/.roborev/
