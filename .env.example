# Local credentials and optional asset settings for development. Copy this to
# `.env`, which git ignores, and write values bare, with no quotes. The server
# reads an application setting from the environment only when the selected
# TOML file explicitly references it, for example
# `client_secret = { env = "LIBREPAPER_GITHUB_CLIENT_SECRET" }` in
# `tools/dev.toml`.

# A GitHub OAuth app for this machine, from github.com/settings/developers
# (New OAuth App). Both of its URLs name the port the Makefile fixes:
#
#     Homepage URL                http://localhost:8081
#     Authorization callback URL  http://localhost:8081/auth/callback
#
# Sign in to get five private example documents owned by your account.
# Every new account gets its own copies through the ordinary sign-in flow.
LIBREPAPER_GITHUB_CLIENT_ID=
LIBREPAPER_GITHUB_CLIENT_SECRET=

# Access policies live in the selected TOML file as string arrays, for example
# `publishers = ["any"]` and `commenters = ["anyone"]` under `[access]`.

# Optional HTTPS static mirror URL. The selected TOML file must explicitly
# reference this variable with `mirror = { env = "LIBREPAPER_ASSET_MIRROR" }`.
LIBREPAPER_ASSET_MIRROR=https://librepaper-s3-assets-0001.s3.bhs.io.cloud.ovh.net/
# Additional Typst fonts, when `assets.typst_fonts` explicitly references it.
# LIBREPAPER_TYPST_FONTS=/srv/librepaper/fonts

# Server settings such as origins, limits, storage paths, and backup policy
# are configured in TOML. `LIBREPAPER_CONFIG` is not read implicitly.
