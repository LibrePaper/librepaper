# Copy to .env, which is ignored by git, and fill in.
# Quotes are optional: Make keeps them, but the server strips them.

# From https://github.com/settings/developers, with the callback URL
# http://localhost:8081/auth/callback
KOMODOC_GITHUB_CLIENT_ID=
KOMODOC_GITHUB_CLIENT_SECRET=

# Who may publish: a GitHub login, a comma-separated list, or "any".
KOMODOC_PUBLISHERS=any

# Who may comment: "anyone" (no sign-in), "any" GitHub account, or a list.
KOMODOC_COMMENTERS=anyone
