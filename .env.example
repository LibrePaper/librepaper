# Local settings for `make serve` and `make deploy`. The Makefile exports this
# file as is into the server's environment; the server reads these supported
# settings directly (see "Environment variables" in the README). Copy it to
# .env, which git ignores, and write values bare, with no quotes.

# A GitHub OAuth app for this machine, from github.com/settings/developers
# (New OAuth App). Both of its URLs name the port the Makefile fixes:
#
#     Homepage URL                http://localhost:8081
#     Authorization callback URL  http://localhost:8081/auth/callback
#
# Sign in to get four private example documents owned by your account.
# Every new account gets its own copies through the ordinary sign-in flow.
LIBREPAPER_GITHUB_CLIENT_ID=
LIBREPAPER_GITHUB_CLIENT_SECRET=

# Who may publish and who may comment: a GitHub login, a list of them, `any`
# signed-in account. Publishing always requires Google or GitHub authentication.
# Documents still belong to their creator; visitors need a link.
LIBREPAPER_PUBLISHERS=any
LIBREPAPER_COMMENTERS=anyone

# Optional deployment cost controls. Bare integers mean bytes; binary units such
# as 10GiB are accepted. Omit the transfer budget for unlimited origin transfer.
# LIBREPAPER_BUDGET_TRANSFER=10GiB
LIBREPAPER_BUDGET_DOCUMENT_ASSETS=32

# Optional HTTPS static mirror URL for browser compiler distribution and
# additional Typst fonts served by this origin.
LIBREPAPER_LATEX_MIRROR=https://latex.librepaper.workers.dev/
# LIBREPAPER_TYPST_FONTS=/srv/librepaper/fonts

# Optional advanced YAML guardrails (for example, top-level trusted_proxies or
# an optional reporting-only backup declaration).
# LIBREPAPER_CONFIG=/etc/librepaper/config.yaml
