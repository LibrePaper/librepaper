# Local settings for `make serve` and `make deploy`. The Makefile exports this
# file as is into the server's environment; the server reads it directly, so
# every name here is one of its own flags (see "Environment variables" in the
# README). Copy it to .env, which git ignores, and write values bare, with no
# quotes.

# A GitHub OAuth app for this machine, from github.com/settings/developers
# (New OAuth App). Both of its URLs name the port the Makefile fixes:
#
#     Homepage URL                http://localhost:8081
#     Authorization callback URL  http://localhost:8081/auth/callback
#
# Sign in to get four private example documents owned by your account.
# Every new account gets its own copies through the ordinary sign-in flow.
LIBREPAPER_GITHUB_CLIENT_ID=
LIBREPAPER_GITHUB_CLIENT_SECRET=

# Who may publish and who may comment: a GitHub login, a list of them, `any`
# signed-in account, or `anyone` with no sign-in. These are ceilings on share
# links too: use `anyone` so an Edit or Comment link works in an unsigned
# browser. Documents still belong to their creator; visitors need a link.
LIBREPAPER_PUBLISHERS=anyone
LIBREPAPER_COMMENTERS=anyone
