{
  "dates_just_now": "à l’instant",
  "dates_minutes_ago": "il y a {minutes} min",
  "dates_hours_ago": [{
    "declarations": ["input count", "local countPlural = count: plural"],
    "selectors": ["countPlural"],
    "match": { "countPlural=one": "il y a {count} heure", "countPlural=*": "il y a {count} heures" }
  }],
  "dates_today": "aujourd’hui",
  "dates_yesterday": "hier",
  "dates_days_ago": "il y a {days} jours"
}
