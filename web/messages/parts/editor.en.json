{
  "editor_bibliography_unavailable": "Bibliography unavailable: {reason}",
  "editor_parser_not_loaded": "the parser could not be loaded",
  "editor_zotero_needs_file": "Open a file that can be edited before importing from Zotero.",
  "editor_zotero_changed": "The document changed while Zotero answered. Try again.",
  "editor_cut_changed": "The source changed before Cut finished. Select the text again.",
  "editor_paste_changed": "The source changed before Paste finished. Try again.",
  "editor_problems_none": "No problems in this file",
  "editor_problems_errors": [{
    "declarations": ["input count", "local countPlural = count: plural"],
    "selectors": ["countPlural"],
    "match": { "countPlural=one": "{count} error in this file", "countPlural=*": "{count} errors in this file" }
  }],
  "editor_problems_warnings": [{
    "declarations": ["input count", "local countPlural = count: plural"],
    "selectors": ["countPlural"],
    "match": { "countPlural=one": "{count} warning in this file", "countPlural=*": "{count} warnings in this file" }
  }],
  "editor_problems_both": [{
    "declarations": ["input errors", "input warnings", "local errorsPlural = errors: plural", "local warningsPlural = warnings: plural"],
    "selectors": ["errorsPlural", "warningsPlural"],
    "match": {
      "errorsPlural=one warningsPlural=one": "{errors} error, {warnings} warning in this file",
      "errorsPlural=one warningsPlural=*": "{errors} error, {warnings} warnings in this file",
      "errorsPlural=* warningsPlural=one": "{errors} errors, {warnings} warning in this file",
      "errorsPlural=* warningsPlural=*": "{errors} errors, {warnings} warnings in this file"
    }
  }],
  "editor_aria_label_of": "Editor of {path}",
  "editor_aria_label": "Editor"
}
