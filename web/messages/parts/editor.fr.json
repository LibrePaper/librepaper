    "match": {
      "errorsPlural=one warningsPlural=one": "{errors} erreur, {warnings} avertissement dans ce fichier",
      "errorsPlural=one warningsPlural=*": "{errors} erreur, {warnings} avertissements dans ce fichier",
      "errorsPlural=* warningsPlural=one": "{errors} erreurs, {warnings} avertissement dans ce fichier",
      "errorsPlural=* warningsPlural=*": "{errors} erreurs, {warnings} avertissements dans ce fichier"
    }
  }],
