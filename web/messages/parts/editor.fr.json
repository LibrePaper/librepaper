    "match": { "countPlural=one": "{count} erreur dans ce fichier", "countPlural=*": "{count} erreurs dans ce fichier" }
  }],
  "editor_problems_warnings": [{
    "declarations": ["input count", "local countPlural = count: plural"],
    "selectors": ["countPlural"],
