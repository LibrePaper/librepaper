{
  "name": "librepaper-web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node tests/unit/vocabulary.js && vite build && vite build --config vite.agent.config.js && node tools/vendor-katex.mjs && node tools/compress-shell.mjs",
    "build:site": "node tools/build-site.mjs && vite build --config vite.site.config.js",
    "serve:site": "vite preview --config vite.site.config.js",
    "dev": "vite build --watch",
    "check:types": "svelte-check --tsconfig ./jsconfig.json --output human",
    "check:review": "node tests/unit/proposal-marks.mjs && node tests/browser/changes-browser.mjs",
    "check:frame-overlays": "node tests/unit/frame-overlays.mjs",
    "check:render-diagnostics": "node tests/unit/render-diagnostics.mjs",
    "check:recovery": "node tests/integration/slow-subscriber-recovery.mjs",
    "check:pending-budget": "node tests/integration/pending-budget-recovery.mjs",
    "check:project-session": "node tests/unit/project-session.mjs && node tests/unit/collab-awareness.mjs && node tests/unit/reader-races.mjs",
    "check:offline-browser": "node tests/browser/editor-browser.mjs",
    "check:render-coordinator": "node tests/unit/render-coordinator.mjs",
    "check:upload": "node tests/unit/zip.mjs && node tests/unit/project-upload.mjs && node tests/unit/landing.mjs && node tests/browser/upload-browser.mjs",
    "check:shortcuts": "node tests/unit/commands.mjs && node tests/browser/shortcuts-browser.mjs",
    "check:synctex": "node tests/unit/synctex.mjs",
    "check": "node --experimental-transform-types --test 'tests/unit/*.mjs' 'tests/unit/*.js' 'tests/integration/*.mjs' 'tests/integration/*.js'",
    "check:companion": "node tests/integration/local-companion.mjs && node tests/integration/companion-lifecycle.mjs && node tests/browser/local-consent-browser.mjs",
    "check:browser": "node --test --test-concurrency=4 'tests/browser/*.mjs'",
    "check:math-browser": "node tests/browser/math-browser.mjs",
    "check:history": "node tests/unit/timeline.mjs && node tests/unit/history-calendar.mjs && node tests/unit/activity.mjs && node tests/integration/history-source.mjs && node tests/unit/reader-races.mjs",
    "check:history-browser": "node tests/browser/history-reader-browser.mjs && node tests/browser/history-panel-browser.mjs",
    "check:typst-pdf": "node tests/integration/typst-pdf.mjs",
    "check:typst-viewer": "node tests/browser/typst-viewer.mjs",
    "check:latex-html-browser": "node tests/browser/latex-html-browser.mjs",
    "check:latex-browser": "node tests/browser/latex-browser.mjs both",
    "check:build-local": "node tests/integration/build-local.mjs",
    "check:agent-browser": "node tests/browser/agent-browser.mjs",
    "check:responsive-browser": "node tests/browser/responsive-browser.mjs",
    "check:accessibility": "node tests/browser/accessibility-browser.mjs",
    "check:assistant-browser": "node tests/browser/agent-browser.mjs && node tests/browser/assistant-review-browser.mjs",
    "check:insert": "node tests/unit/insert.mjs && node tests/integration/insert-markdown-render.mjs && node tests/browser/insert-browser.mjs",
    "check:insert-renderers": "node tests/integration/insert-latex-render.mjs && node tests/integration/insert-typst-render.mjs && node tests/integration/insert-quarto-render.mjs"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "axe-core": "^4.13.0",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.9.0",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-markdown": "^6.3.4",
    "@codemirror/language": "^6.11.3",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/merge": "^6.8.0",
    "@codemirror/search": "^6.5.11",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.39.1",
    "@replit/codemirror-emacs": "6.1.0",
    "@replit/codemirror-vim": "^6.4.0",
    "@skeletonlabs/skeleton": "5",
    "@skeletonlabs/skeleton-svelte": "5",
    "@tailwindcss/vite": "4",
    "katex": "^0.18.7",
    "loro-crdt": "1.16.1",
    "pdfjs-dist": "5.4.149",
    "svelte": "^5.57.0",
    "tailwindcss": "4"
  }
}
