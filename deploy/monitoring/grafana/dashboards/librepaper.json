{
  "id": null,
  "uid": "librepaper-operations",
  "title": "LibrePaper operations",
  "tags": ["librepaper", "operations"],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "15s",
  "time": {"from": "now-6h", "to": "now"},
  "annotations": {"list": [{"builtIn": 1, "datasource": {"type": "grafana", "uid": "-- Grafana --"}, "enable": true, "hide": true, "iconColor": "rgba(0, 211, 255, 1)", "name": "Annotations & Alerts", "type": "dashboard"}]},
  "panels": [
    {"id": 1, "title": "HTTP requests / second", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "sum by (route) (rate(librepaper_http_requests_total[5m]))", "legendFormat": "{{route}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "reqps", "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 10}}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}},
    {"id": 2, "title": "HTTP 5xx responses / second", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "sum(rate(librepaper_http_requests_total{status_class=\"5xx\"}[5m])) or vector(0)", "legendFormat": "5xx", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "reqps", "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 15}}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}},
    {"id": 3, "title": "HTTP request latency p95", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(librepaper_http_request_duration_seconds_bucket[5m])))", "legendFormat": "p95", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "s", "custom": {"drawStyle": "line", "lineWidth": 2}}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}},
    {"id": 4, "title": "Resource refusals / second", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "sum by (reason) (rate(librepaper_resource_refusals_total[5m]))", "legendFormat": "{{reason}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "ops", "custom": {"drawStyle": "line", "lineWidth": 2}}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}},
    {"id": 5, "title": "Documents in active rooms", "type": "stat", "gridPos": {"h": 5, "w": 6, "x": 0, "y": 16}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "librepaper_rooms_documents", "legendFormat": "documents", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}, "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "area"}},
    {"id": 6, "title": "Active sockets", "type": "stat", "gridPos": {"h": 5, "w": 6, "x": 6, "y": 16}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "librepaper_sockets_active", "legendFormat": "sockets", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}, "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "area"}},
    {"id": 7, "title": "Host CPU busy", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "100 * (1 - avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])))", "legendFormat": "{{instance}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}},
    {"id": 8, "title": "Host memory used", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 21}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)", "legendFormat": "used", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}},
    {"id": 9, "title": "Application database pool", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "librepaper_database_open_connections", "legendFormat": "open", "refId": "A"}, {"expr": "librepaper_database_checked_out_connections", "legendFormat": "checked out", "refId": "B"}, {"expr": "librepaper_database_max_connections", "legendFormat": "pool maximum", "refId": "C"}], "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}},
    {"id": 10, "title": "Host root filesystem available", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 29}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "100 * node_filesystem_avail_bytes{mountpoint=\"/\",fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{mountpoint=\"/\",fstype!~\"tmpfs|overlay\"}", "legendFormat": "{{instance}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}},
    {"id": 11, "title": "Targets up", "type": "stat", "gridPos": {"h": 5, "w": 6, "x": 12, "y": 32}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "up", "instant": true, "legendFormat": "{{job}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "short", "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []}, "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "textMode": "auto", "colorMode": "background", "graphMode": "none"}},
    {"id": 12, "title": "Firing alerts", "type": "stat", "gridPos": {"h": 5, "w": 6, "x": 18, "y": 32}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "sum(ALERTS{alertstate=\"firing\"}) or vector(0)", "legendFormat": "alerts", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "short", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}, "overrides": []}, "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "area"}},
    {"id": 13, "title": "Application resource budgets", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 37}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "librepaper_memory_budget_utilization_ratio", "legendFormat": "memory", "refId": "A"}, {"expr": "librepaper_pending_retained_utilization_ratio", "legendFormat": "pending retained", "refId": "B"}, {"expr": "librepaper_pending_scratch_utilization_ratio", "legendFormat": "pending scratch", "refId": "C"}, {"expr": "librepaper_sockets_deployment_utilization_ratio", "legendFormat": "deployment sockets", "refId": "D"}], "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}},
    {"id": 14, "title": "Background queue capacity", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 37}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "librepaper_background_queued", "legendFormat": "queued", "refId": "A"}, {"expr": "librepaper_background_queue_capacity", "legendFormat": "capacity", "refId": "B"}, {"expr": "librepaper_background_deadlines", "legendFormat": "deadlines", "refId": "C"}, {"expr": "librepaper_background_deadline_capacity", "legendFormat": "deadline capacity", "refId": "D"}], "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}},
    {"id": 15, "title": "Cached storage ledger", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 45}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "librepaper_storage_ledger_deployment_bytes", "legendFormat": "deployment storage ledger", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}},
    {"id": 16, "title": "LibrePaper process memory", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 45}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "librepaper_host_process_rss_bytes", "legendFormat": "current RSS", "refId": "A"}, {"expr": "librepaper_host_process_peak_rss_bytes", "legendFormat": "peak RSS", "refId": "B"}, {"expr": "librepaper_cgroup_memory_limit_bytes", "legendFormat": "container memory limit", "refId": "C"}], "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}},
    {"id": 17, "title": "Collaboration load", "type": "timeseries", "gridPos": {"h": 8, "w": 24, "x": 0, "y": 53}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "librepaper_rooms_documents", "legendFormat": "documents in rooms", "refId": "A"}, {"expr": "librepaper_rooms_subscribers", "legendFormat": "subscribers", "refId": "B"}, {"expr": "librepaper_sockets_active", "legendFormat": "active sockets", "refId": "C"}, {"expr": "librepaper_sockets_max_network_sockets", "legendFormat": "maximum sockets observed on a network", "refId": "D"}], "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}},
    {"id": 18, "title": "Mean database pool wait (since process start)", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 61}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "librepaper_database_begin_wait_mean_seconds", "legendFormat": "mean wait seconds", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}},
    {"id": 19, "title": "PostgreSQL activity and exporter health", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 61}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "rate(pg_stat_database_xact_commit[5m])", "legendFormat": "commits/s {{datname}}", "refId": "A"}, {"expr": "rate(pg_stat_database_xact_rollback[5m])", "legendFormat": "rollbacks/s {{datname}}", "refId": "B"}, {"expr": "pg_up", "legendFormat": "database reachable", "refId": "C"}], "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}}
    ,{"id": 20, "title": "Whole-job last success age", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 69}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "(time() - librepaper_backup_job_last_success_timestamp_seconds{task=\"backup\"}) and on (task) librepaper_backup_job_last_success_timestamp_seconds{task=\"backup\"} > 0", "legendFormat": "backup", "refId": "A"}, {"expr": "(time() - librepaper_backup_job_last_success_timestamp_seconds{task=\"check\"}) and on (task) librepaper_backup_job_last_success_timestamp_seconds{task=\"check\"} > 0", "legendFormat": "repository check", "refId": "B"}], "fieldConfig": {"defaults": {"unit": "s", "custom": {"drawStyle": "line", "lineWidth": 2}}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}},
    {"id": 21, "title": "Restic backup duration", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 69}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "resticprofile_backup_duration_seconds{profile=\"resticprofile\"}", "legendFormat": "duration", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "s", "custom": {"drawStyle": "line", "lineWidth": 2}}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}},
    {"id": 22, "title": "Backup configuration enabled", "type": "stat", "gridPos": {"h": 5, "w": 6, "x": 0, "y": 85}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "librepaper_backup_enabled", "legendFormat": "enabled", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "short", "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []}, "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "textMode": "auto", "colorMode": "background", "graphMode": "none"}},
    {"id": 23, "title": "Backup configuration rejected", "type": "stat", "gridPos": {"h": 5, "w": 6, "x": 6, "y": 85}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "librepaper_backup_config_error", "legendFormat": "config error", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "short", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}, "overrides": []}, "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "textMode": "auto", "colorMode": "background", "graphMode": "none"}},
    {"id": 24, "title": "Whole-job result", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 77}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "librepaper_backup_job_last_result_success", "legendFormat": "{{task}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "short", "min": -1, "max": 1, "custom": {"drawStyle": "line", "lineInterpolation": "stepAfter", "lineWidth": 2}}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}},
    {"id": 25, "title": "Restic bytes added", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 77}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "resticprofile_backup_added_bytes{profile=\"resticprofile\"}", "legendFormat": "added bytes", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "bytes", "custom": {"drawStyle": "line", "lineWidth": 2}}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}}
    {"id": 24, "title": "Whole-job result", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 77}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "librepaper_backup_job_last_result_success", "legendFormat": "{{task}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "short", "min": -1, "max": 1, "custom": {"drawStyle": "line", "lineInterpolation": "stepAfter", "lineWidth": 2}}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}}
  ]
}
