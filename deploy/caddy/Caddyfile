# Caddy obtains a certificate for a name the first time a client asks for it,
# after the server confirms it is one of the two configured origins. Host
# passes through unchanged; the server answers 421 to names it does not serve.
# No ACME email is configured: Let's Encrypt does not need one.
{
	on_demand_tls {
		ask http://librepaper:8080/api/tls/ask
	}
	import local.d/*.global
}

https:// {
	tls {
		on_demand
	}
	encode zstd gzip
	handle {
		reverse_proxy librepaper:8080
	}
}

# Operator additions that survive redeploys: site blocks in caddy/local.d/*.caddy,
# global options in caddy/local.d/*.global. Deploys never write to local.d.
import local.d/*.caddy

# Extra names redirecting to the app origin, for example www:
#
# www.paper.example {
#	redir https://paper.example{uri} permanent
# }
