#!/usr/bin/env bash
# Open the desktop app against the demo, starting the demo when none answers.
#
# Run from the demo worktree root by make demo-desktop. When a demo built from
# this commit already answers on PORT, the app opens against it and the demo is
# left running. When a demo built from another commit answers, it is stopped and
# rebuilt. When a server on PORT that is not the demo answers, the app uses it as
# is. When nothing answers, this script starts the demo, waits for it, and opens
# the app.
# Quitting the app, or pressing Ctrl-C, kills the demo's process group. That lets
# tools/dev/demo/compose run its cleanup and take the containers down.
set -euo pipefail

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)
PORT="${PORT:-8081}"
URL="http://localhost:$PORT/"
APP="$ROOT/desktop/target/${CARGO_PROFILE:-release}/librepaper-desktop"
# NixOS keeps GTK 3's settings schemas out of the session, and without them a
# file picker aborts the app. The packaged app is wrapped; this build is not.
if [ -e /etc/NIXOS ]; then
  gtk=$(nix-build '<nixpkgs>' -A gtk3 --no-out-link)
  export XDG_DATA_DIRS="$(echo "$gtk"/share/gsettings-schemas/*)${XDG_DATA_DIRS:+:$XDG_DATA_DIRS}"
fi
answers() { curl -fsS -o /dev/null "$URL" 2>/dev/null; }
revision=$(git -C "$ROOT" rev-parse HEAD)
# Demo containers carry the compose project and service labels, and the commit
# they were built from in the org.librepaper.demo.revision label.
running_revision() {
  command -v docker >/dev/null 2>&1 || return 0
  docker ps --filter label=com.docker.compose.project=librepaper-demo --filter label=com.docker.compose.service=librepaper --format '{{.Label "org.librepaper.demo.revision"}}' 2>/dev/null | head -n 1 || true
}
demo_running() {
  command -v docker >/dev/null 2>&1 || return 1
  [ -n "$(docker ps -q --filter label=com.docker.compose.project=librepaper-demo --filter label=com.docker.compose.service=librepaper 2>/dev/null)" ]
}

if answers; then
  if ! demo_running; then
    echo "demo-desktop: using the server already running on $URL"
    LIBREPAPER_SERVER="$URL" exec "$APP"
  fi
  have=$(running_revision)
  if [ "$have" = "$revision" ]; then
    echo "demo-desktop: using the demo of ${revision:0:8} already running on $URL"
    LIBREPAPER_SERVER="$URL" exec "$APP"
  fi
  if [ -n "$have" ]; then
    from="${have:0:8}"
  else
    from="an unknown commit"
  fi
  echo "demo-desktop: the running demo is from $from, not ${revision:0:8}; stopping it"
  "$ROOT/tools/dev/demo/compose" stop
  while answers; do sleep 1; done
fi

LOG="$ROOT/target/demo-desktop.log"
mkdir -p "$ROOT/target"
echo "demo-desktop: starting the demo (log: $LOG)"
# The demo runs in a background process group, which cannot read the terminal.
# A passphrase-protected age identity is therefore unlocked here, in the foreground.
demo_key=()
if [ -z "${DEV_GITHUB_CLIENT_ID:-}" ] && [ -z "${SOPS_AGE_KEY:-}" ] && [ -n "${SOPS_AGE_KEY_CMD:-}" ]; then
  if identity=$(eval "$SOPS_AGE_KEY_CMD"); then
    # Unset the command rather than empty it: sops runs SOPS_AGE_KEY_CMD whenever
    # it is set, and an empty one crashes the decrypt.
    demo_key=(-u SOPS_AGE_KEY_CMD SOPS_AGE_KEY="$identity")
  else
    echo "demo-desktop: could not unlock the age identity; starting the demo without sign-in" >&2
  fi
fi
# The demo gets its own process group, so Ctrl-C reaches only this script and the app.
set -m
env -u CONFIG ${demo_key[@]+"${demo_key[@]}"} "${MAKE:-make}" -C "$ROOT" --no-print-directory demo-checkout OPEN=0 >"$LOG" 2>&1 &
demo=$!
set +m
# make exits before compose has taken the containers down, so wait for the
# whole process group, not only for make.
stop() {
  kill -TERM -- "-$demo" 2>/dev/null || true
  wait "$demo" 2>/dev/null || true
  while kill -0 -- "-$demo" 2>/dev/null; do sleep 0.5; done
}
trap stop EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

until answers; do
  if ! kill -0 "$demo" 2>/dev/null; then
    echo "demo-desktop: the demo did not start; the end of $LOG:" >&2
    tail -n 40 "$LOG" >&2
    exit 1
  fi
  sleep 2
done
echo "demo-desktop: the demo is up on $URL; quitting the app stops it"
LIBREPAPER_SERVER="$URL" "$APP"
