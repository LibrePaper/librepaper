#!/usr/bin/env bash
set -euo pipefail

# Database management dispatcher for LibrePaper.
# Works from any current working directory.

REPO_ROOT=$(git -C "$(dirname "${BASH_SOURCE[0]}")" rev-parse --show-toplevel)
cd "$REPO_ROOT" || exit 1
. "$REPO_ROOT/tools/test/postgres.sh"

# Database configuration (from Makefile)
DEV_POSTGRES_CONTAINER="${DEV_POSTGRES_CONTAINER:-librepaper-postgres}"
DEV_POSTGRES_PORT="${DEV_POSTGRES_PORT:-55432}"
DEV_POSTGRES_VOLUME="${DEV_POSTGRES_VOLUME:-librepaper-postgres-data}"
DEV_POSTGRES_PASSWORD="${DEV_POSTGRES_PASSWORD:-librepaper-local}"
DEV_POSTGRES_DB="librepaper"
DEV_POSTGRES_URL="postgresql://postgres:${DEV_POSTGRES_PASSWORD}@127.0.0.1:${DEV_POSTGRES_PORT}/${DEV_POSTGRES_DB}"

SQLX_POSTGRES_DB="${SQLX_POSTGRES_DB:-librepaper_sqlx}"
SQLX_DATABASE_URL="postgresql://postgres:${DEV_POSTGRES_PASSWORD}@127.0.0.1:${DEV_POSTGRES_PORT}/${SQLX_POSTGRES_DB}"

# Print help text.
print_help() {
    cat <<'EOF'
Usage: tools/dev/db <command>

Commands:
  dev                Start the persistent PostgreSQL used by local deploy
  url                Print the dev database URL
  wipe               Drop and recreate the dev database
  test               Run PostgreSQL-gated tests in a throwaway container
  sqlx-check         Fail if crates/librepaper-engine/.sqlx/ no longer matches the queries in the tree
  sqlx-prepare       Regenerate crates/librepaper-engine/.sqlx/ after changing any query or migration
  help               Show this help text

Environment variables:
  DEV_POSTGRES_CONTAINER   Docker container name (default: librepaper-postgres)
  DEV_POSTGRES_PORT        PostgreSQL port (default: 55432)
  DEV_POSTGRES_VOLUME      Docker volume name (default: librepaper-postgres-data)
  DEV_POSTGRES_PASSWORD    PostgreSQL password (default: librepaper-local)
  SQLX_POSTGRES_DB         SQLX database name (default: librepaper_sqlx)
EOF
}

# Start PostgreSQL Docker container and wait for it to be ready.
cmd_dev() {
    if ! command -v docker >/dev/null; then
        echo "error: docker is required" >&2
        exit 1
    fi

    # Check if container already exists; if not, create it.
    if ! docker inspect "$DEV_POSTGRES_CONTAINER" >/dev/null 2>&1; then
        docker run -d \
            --name "$DEV_POSTGRES_CONTAINER" --restart unless-stopped \
            -p 127.0.0.1:"$DEV_POSTGRES_PORT":5432 \
            -e POSTGRES_PASSWORD="$DEV_POSTGRES_PASSWORD" -e POSTGRES_DB="$DEV_POSTGRES_DB" \
            -v "$DEV_POSTGRES_VOLUME":/var/lib/postgresql/data "$POSTGRES_IMAGE" >/dev/null
    fi

    # Start the container if not running.
    docker start "$DEV_POSTGRES_CONTAINER" >/dev/null

    # Wait for PostgreSQL to be ready (up to 30 seconds). The init server answers on the Unix
    # socket then shuts down, so probe over TCP.
    for _ in $(seq 1 30); do
        if docker exec "$DEV_POSTGRES_CONTAINER" pg_isready -h 127.0.0.1 -U postgres -d librepaper >/dev/null 2>&1; then
            echo "$DEV_POSTGRES_URL"
            return 0
        fi
        sleep 1
    done

    echo "error: PostgreSQL did not become ready" >&2
    exit 1
}

validate_sqlx_database_name() {
    if [[ ! "$SQLX_POSTGRES_DB" =~ ^[A-Za-z_][A-Za-z0-9_]{0,62}$ ]]; then
        echo "error: SQLX_POSTGRES_DB must be a PostgreSQL identifier (1-63 ASCII letters, digits, or underscores; first character must be a letter or underscore)" >&2
        exit 1
    fi
    if [ "$SQLX_POSTGRES_DB" = "$DEV_POSTGRES_DB" ]; then
        echo "error: SQLX_POSTGRES_DB must not match the persistent development database '$DEV_POSTGRES_DB'" >&2
        exit 1
    fi
}

# Print the dev database URL.
cmd_url() {
    echo "$DEV_POSTGRES_URL"
}

# Recreate the sqlx database and run migrations.
cmd_sqlx_database() {
    validate_sqlx_database_name

    # Ensure PostgreSQL is running.
    cmd_dev >/dev/null

    # Drop and recreate the database.
    docker exec "$DEV_POSTGRES_CONTAINER" psql -U postgres -c "DROP DATABASE IF EXISTS \"$SQLX_POSTGRES_DB\"" >/dev/null
    docker exec "$DEV_POSTGRES_CONTAINER" psql -U postgres -c "CREATE DATABASE \"$SQLX_POSTGRES_DB\"" >/dev/null

    # Run migrations.
    DATABASE_URL="$SQLX_DATABASE_URL" sqlx migrate run --source crates/librepaper-engine/migrations/postgres
}

# Fail if crates/librepaper-engine/.sqlx/ no longer matches the queries.
cmd_sqlx_check() {
    cmd_sqlx_database >/dev/null
    SQLX_OFFLINE=false DATABASE_URL="$SQLX_DATABASE_URL" cargo sqlx prepare --check --workspace -- --all-targets
}

# Regenerate crates/librepaper-engine/.sqlx/ after changing queries or migrations.
cmd_sqlx_prepare() {
    cmd_sqlx_database >/dev/null
    SQLX_OFFLINE=false DATABASE_URL="$SQLX_DATABASE_URL" cargo sqlx prepare --workspace -- --all-targets
}

# Drop and recreate the dev database.
cmd_wipe() {
    # Ensure PostgreSQL is running.
    cmd_dev >/dev/null

    # FORCE, because a server that outlived `make kill` still holds a connection.
    docker exec "$DEV_POSTGRES_CONTAINER" psql -U postgres -c "DROP DATABASE IF EXISTS \"$DEV_POSTGRES_DB\" WITH (FORCE)" >/dev/null
    docker exec "$DEV_POSTGRES_CONTAINER" psql -U postgres -c "CREATE DATABASE \"$DEV_POSTGRES_DB\"" >/dev/null
}

# Run PostgreSQL-gated tests in a throwaway container.
cmd_test() {
    trap postgres_stop_disposable EXIT
    postgres_start_disposable "librepaper-test-pg-$$" test
    local port="$POSTGRES_PORT" container="$POSTGRES_CONTAINER"

    # One database per run below: each truncates the tables it uses.
    docker exec "$container" psql -U postgres -qc 'CREATE DATABASE lp_lib' -c 'CREATE DATABASE lp_gates'

    # Run the PostgreSQL-gated tests. --test-threads=1 is mandatory: tests count every commit
    # and TRUNCATE a shared database. The skips are long benchmarks/probes and the Quarto
    # cases, which need toolchains.
    export LIBREPAPER_TEST_POSTGRES_URL="postgresql://postgres:test@127.0.0.1:$port/lp_lib"

    local -a skips=(
        --skip typing_throughput_release_benchmark
        --skip compaction_cost_release_benchmark
        --skip concurrent_compaction_release_benchmark
        --skip update_import_cost_probe
        --skip batched_import_cost_probe
        --skip active_document_capacity_benchmark
        --skip mixed_traffic_capacity_benchmark
        --skip reconnect_burst_capacity_benchmark
        --skip maintenance_backlog_capacity_benchmark
        --skip benchmark_shared_fanout
        --skip real_quarto_pdf_preview_publishes_complete_pdf_bytes
        --skip real_quarto_render_reports_success_and_retains_a_failure_log
    )

    cargo test -p librepaper-engine --lib -- --ignored --test-threads=1 "${skips[@]}"
    cargo test -p librepaper-room --lib -- --ignored --test-threads=1 "${skips[@]}"
    cargo test -p librepaper-server --lib -- --ignored --test-threads=1 "${skips[@]}"

    export LIBREPAPER_TEST_POSTGRES_URL="postgresql://postgres:test@127.0.0.1:$port/lp_gates"
    cargo test -p librepaper --test deployment_gates -- --ignored --test-threads=1
}

# Main dispatcher.
main() {
    local cmd="${1:-help}"

    case "$cmd" in
        dev)
            cmd_dev
            ;;
        url)
            cmd_url
            ;;
        wipe)
            cmd_wipe
            ;;
        test)
            cmd_test
            ;;
        sqlx-check)
            cmd_sqlx_check
            ;;
        sqlx-prepare)
            cmd_sqlx_prepare
            ;;
        help | -h | --help)
            print_help
            ;;
        *)
            echo "error: unknown command '$cmd'" >&2
            print_help >&2
            exit 1
            ;;
    esac
}

main "$@"
