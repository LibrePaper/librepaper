#!/usr/bin/env bash
set -euo pipefail

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)
PROJECT="${DEMO_PROJECT:-librepaper-demo}"
DEMO_STATE_FILE="$ROOT/tools/dev/demo/.${PROJECT}.setup-state.json"
DEMO_ENV_FILE="$ROOT/tools/dev/demo/.${PROJECT}.env"
DEMO_SECRETS_DIR="$ROOT/tools/dev/demo/${PROJECT}-secrets"
COMPOSE_FILES=(
  -f "$ROOT/deploy/compose.yaml"
  -f "$ROOT/deploy/compose.monitoring.yaml"
  -f "$ROOT/tools/dev/demo/compose.yaml"
)
ACTION="${1:-run}"
CONFIG_PATH="${CONFIG:-tools/dev/demo/config.toml}"
BACKUP_CONFIG_PATH="${RESTICPROFILE_CONFIG:-deploy/resticprofile.toml}"
PORT="${PORT:-8081}"
SITE_PORT="${SITE_PORT:-8082}"
BIN="${BIN:-$ROOT/dist/librepaper}"
APP_ORIGIN="http://localhost:$PORT"

die() { printf 'demo: %s\n' "$*" >&2; exit 1; }

if ! command -v docker >/dev/null 2>&1; then
  die 'Docker is required'
fi

compose_version=$(docker compose version --short 2>/dev/null) || die 'Docker Compose 2.24.4 or later is required'
compose_version=${compose_version#v}
if [[ ! "$compose_version" =~ ^([0-9]+)\.([0-9]+)\.([0-9]+) ]]; then
  die "could not read Docker Compose version '$compose_version'"
fi
major=$((10#${BASH_REMATCH[1]}))
minor=$((10#${BASH_REMATCH[2]}))
patch=$((10#${BASH_REMATCH[3]}))
if (( major < 2 || (major == 2 && minor < 24) || (major == 2 && minor == 24 && patch < 4) )); then
  die "Docker Compose 2.24.4 or later is required; found $compose_version"
fi

if [[ "$CONFIG_PATH" != /* ]]; then
	CONFIG_PATH="$ROOT/$CONFIG_PATH"
fi
if [[ "$BACKUP_CONFIG_PATH" != /* ]]; then
	BACKUP_CONFIG_PATH="$ROOT/$BACKUP_CONFIG_PATH"
fi
[[ "$PROJECT" =~ ^librepaper-demo[a-z0-9_-]*$ ]] || die 'DEMO_PROJECT must start with librepaper-demo'

compose() (
  export LIBREPAPER_DEMO_ROOT="$ROOT"
  export LIBREPAPER_DEMO_CONFIG="$CONFIG_PATH"
  export LIBREPAPER_DEMO_BACKUP_CONFIG="$BACKUP_CONFIG_PATH"
  export LIBREPAPER_DEMO_APP_ORIGIN="$APP_ORIGIN"
  export LIBREPAPER_DEMO_SITE_ORIGIN="http://localhost:$SITE_PORT"
  export LIBREPAPER_SECRETS_DIR="$DEMO_SECRETS_DIR"
  export PORT SITE_PORT
  if [[ -f "$DEMO_ENV_FILE" ]]; then
    exec docker compose --env-file "$DEMO_ENV_FILE" --project-name "$PROJECT" --project-directory "$ROOT/deploy" "${COMPOSE_FILES[@]}" "$@"
  fi
  exec docker compose --project-name "$PROJECT" --project-directory "$ROOT/deploy" "${COMPOSE_FILES[@]}" "$@"
)

prepare_setup() {
  mkdir -p "$DEMO_SECRETS_DIR"
  chmod 700 "$DEMO_SECRETS_DIR"
  for name in github_client_id github_client_secret grafana_admin_password; do
    if [[ ! -s "$DEMO_SECRETS_DIR/$name" ]]; then
      value=demo-unused
      [[ "$name" != grafana_admin_password ]] || value="${LIBREPAPER_DEMO_GRAFANA_PASSWORD:-librepaper-demo-only}"
      printf '%s\n' "$value" | "$ROOT/deploy/setup" set-secret --secrets-dir "$DEMO_SECRETS_DIR" "$name" >/dev/null
    fi
  done
  "$ROOT/deploy/setup" init --database local --local-build --monitoring \
    --project "$PROJECT" --secrets-dir "$DEMO_SECRETS_DIR" \
    --state-file "$DEMO_STATE_FILE" --env-file "$DEMO_ENV_FILE" || {
      echo 'demo: setup failed; existing project volumes were preserved. If this is a disposable demo from an older setup, run make demo-wipe and retry.' >&2
      return 1
    }
}

case "$ACTION" in
  run)
    [[ -f "$CONFIG_PATH" ]] || die "config file does not exist: $CONFIG_PATH"
    [[ -f "$BACKUP_CONFIG_PATH" ]] || die "backup config file does not exist: $BACKUP_CONFIG_PATH"
    [[ -x "$BIN" ]] || die "host companion binary is not executable: $BIN"
    prepare_setup
    compose_started=0
    companion_pid=''
    logs_pid=''
    cleanup() {
      local result=$?
      trap - EXIT INT TERM
      if [[ -n "$logs_pid" ]]; then
        kill "$logs_pid" 2>/dev/null || true
        wait "$logs_pid" 2>/dev/null || true
      fi
      if [[ -n "$companion_pid" ]]; then
        kill "$companion_pid" 2>/dev/null || true
        wait "$companion_pid" 2>/dev/null || true
      fi
      if (( compose_started )); then
        if (( result != 0 )); then
          echo 'demo: recent container logs before cleanup:' >&2
          compose logs --tail=100 || true
        fi
        compose down --remove-orphans || true
      fi
      exit "$result"
    }
    trap cleanup EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM

    compose_started=1
    compose up --build --detach --wait --wait-timeout 180

    if LIBREPAPER_SERVER="$APP_ORIGIN" "$BIN" status >/dev/null 2>&1; then
      echo "local $(LIBREPAPER_SERVER="$APP_ORIGIN" "$BIN" status | sed -n 2p)  (already running; left alone)"
    else
      LIBREPAPER_SERVER="$APP_ORIGIN" "$BIN" start --foreground >/dev/null 2>&1 &
      companion_pid=$!
    fi

    if [[ "${OPEN:-1}" = 1 ]] && command -v firefox >/dev/null 2>&1; then
      (sleep 1; firefox "http://localhost:$SITE_PORT" >/dev/null 2>&1 &) || true
    fi
    printf 'app   %s\n' "$APP_ORIGIN"
    printf 'site  http://localhost:%s\n' "$SITE_PORT"
    printf 'Press Ctrl-C to stop the demo containers and any companion started here.\n'
    compose logs --follow &
    logs_pid=$!
    wait "$logs_pid"
    ;;
  stop)
    compose down --remove-orphans
    ;;
  wipe)
    compose down --remove-orphans --volumes
    ;;
  *)
    die 'usage: tools/dev/demo-compose {run|stop|wipe}'
    ;;
esac
