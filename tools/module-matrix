#!/bin/sh
# Counts `crate::<module>` references between the top-level modules of
# crates/librepaper/src, in the shape of the table in
# docs/dev/specs/SPEC-split-crates.md. Rows are the referencing module,
# columns the referenced one.
#
#   tools/module-matrix           print the matrix
#   tools/module-matrix --check   exit 1 if a forbidden edge is nonzero
set -eu

root=$(cd "$(dirname "$0")/.." && pwd)
src=$root/crates/librepaper/src
mods=$(cd "$src" && for e in *; do
    case $e in lib.rs | main.rs | tests) ;; *) echo "${e%.rs}" ;; esac
done)

nmods=$(echo "$mods" | grep -c .)
if [ "$nmods" -lt 2 ]; then
    echo "facade has no cross-module edges (modules left: $(echo $mods))"
    exit 0
fi

# Number of references from module $1 to module $2.
count() {
    if [ -d "$src/$1" ]; then path=$src/$1; else path=$src/$1.rs; fi
    grep -rEo "crate::$2\\b" "$path" 2>/dev/null | wc -l
}

# Whether the edge $1 -> $2 is forbidden.
forbidden() {
    case "$1>$2" in
        config\>log | config\>server) return 0 ;;
        document\>storage | document\>log | document\>room | document\>server) return 0 ;;
        log\>room | log\>server | storage\>room | storage\>server | room\>server) return 0 ;;
        local\>cli | assistant\>cli | automation\>cli) return 0 ;;
        local\>storage | local\>log | local\>room | local\>server) return 0 ;;
        util\>*) return 0 ;;
        auth\>http | auth\>util) return 1 ;;
        auth\>*) return 0 ;;
    esac
    return 1
}

if [ "${1:-}" = "--check" ]; then
    status=0
    for from in $mods; do
        for to in $mods; do
            [ "$from" = "$to" ] && continue
            n=$(count "$from" "$to")
            if [ "$n" -gt 0 ] && forbidden "$from" "$to"; then
                echo "forbidden edge $from -> $to: $n references"
                status=1
            fi
        done
    done
    exit $status
fi

printf '%-12s' ''
for to in $mods; do printf ' %4.4s' "$to"; done
echo
for from in $mods; do
    printf '%-12s' "$from"
    for to in $mods; do
        if [ "$from" = "$to" ]; then
            printf ' %4s' .
            continue
        fi
        n=$(count "$from" "$to")
        if [ "$n" -eq 0 ]; then printf ' %4s' -; else printf ' %4d' "$n"; fi
    done
    echo
done
