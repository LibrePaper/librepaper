{
  "Statement": [
    {
      "Sid": "mirror",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket", "s3:PutBucketCORS", "s3:GetBucketCORS",
        "s3:GetObject", "s3:PutObject", "s3:PutObjectAcl",
        "s3:ListBucket", "s3:GetBucketLocation",
        "s3:ListBucketMultipartUploads", "s3:ListMultipartUploadParts", "s3:AbortMultipartUpload"
      ],
      "Resource": [
        "arn:aws:s3:::librepaper-mirror-0001",
        "arn:aws:s3:::librepaper-mirror-0001/*"
      ]
    }
  ]
}
