{
  "Statement": [
    {
      "Sid": "objects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject", "s3:PutObject", "s3:DeleteObject",
        "s3:ListBucket", "s3:GetBucketLocation",
        "s3:ListBucketMultipartUploads", "s3:ListMultipartUploadParts", "s3:AbortMultipartUpload"
      ],
      "Resource": [
        "arn:aws:s3:::librepaper-objects-0001",
        "arn:aws:s3:::librepaper-objects-0001/*"
      ]
    }
  ]
}
