#!/usr/bin/env bash
# Deploy the official instance at librepaper.org. Secrets come from
# tools/deploy/keys.yaml (SOPS); runbook encrypted in tools/deploy/runbook.enc.
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/../.."

HOST="${HOST:-ubuntu@librepaper.org}"
SITE=librepaper.org       # landing page and manual, from docs/_site (make site)
APP=app.librepaper.org    # the application: origin in tools/deploy/production.toml
DOCS=docs.librepaper.org  # published documents: origin in tools/deploy/production.toml
REDIRECTS='www.librepaper.org, librepaper.com, www.librepaper.com'
ASSET=librepaper-x86_64-unknown-linux-musl.tar.xz
ADMIN=https://admin.librepaper.org/  # operator graphs: origin in tools/deploy/production.toml
ADMIN_NAME=admin.librepaper.org  # hostname extracted from ADMIN
HTTP_CONNECT_TIMEOUT=5
HTTP_REQUEST_TIMEOUT=15
HEALTH_DEADLINE_SECONDS=120

if [ -t 1 ]; then bold=$'\e[1m' green=$'\e[32m' red=$'\e[31m' dim=$'\e[2m' reset=$'\e[0m'; else bold='' green='' red='' dim='' reset=''; fi
step() { printf '\n%s==> %s%s\n' "$bold" "$*" "$reset"; }
ok() { printf '    %s%s%s\n' "$green" "$*" "$reset"; }
note() { printf '    %s%s%s\n' "$dim" "$*" "$reset"; }

die() { printf '%sdeploy-production: %s%s\n' "$red" "$*" "$reset" >&2; exit 1; }
http_request() {
	curl --connect-timeout "$HTTP_CONNECT_TIMEOUT" --max-time "$HTTP_REQUEST_TIMEOUT" "$@"
}
key() { sops --decrypt --extract "[\"$1\"]" tools/deploy/keys.yaml; }
required_key() {
	local name="$1" value
	if ! value=$(key "$name" 2>/dev/null); then
		die "could not decrypt required key $name in tools/deploy/keys.yaml"
	fi
	if [[ ! "$value" =~ [^[:space:]] ]] || [[ "${value,,}" =~ ^[[:space:]]*(null|~)[[:space:]]*$ ]]; then
		die "required key $name in tools/deploy/keys.yaml is empty or null"
	fi
	printf '%s' "$value"
}

validate_release_version() {
	local version="$1" major minor patch
	if [[ ! "$version" =~ ^v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$ ]]; then
		die "release version must be a canonical tag such as v0.0.24"
	fi
	major="${BASH_REMATCH[1]}"
	minor="${BASH_REMATCH[2]}"
	patch="${BASH_REMATCH[3]}"
	if (( major == 0 && minor == 0 && patch < 24 )); then
		die "production deployment requires v0.0.24 or later: older releases do not know the squashed migration history production now records"
	fi
}

VERIFY_TMP_FILES=()
cleanup_verify_tmp() {
	if [ "${#VERIFY_TMP_FILES[@]}" -gt 0 ]; then rm -f -- "${VERIFY_TMP_FILES[@]}"; fi
}

write_compose_files() {
	# Compose appends the volumes of an override to those of compose.yaml, so
	# only the mounts that are specific to this host belong here.
	ssh "$HOST" 'umask 022; cat > librepaper/compose.override.yaml.tmp && chmod 644 librepaper/compose.override.yaml.tmp && mv -f librepaper/compose.override.yaml.tmp librepaper/compose.override.yaml' <<'OVERRIDE'
services:
  caddy:
    volumes:
      - ./site:/srv/site:ro
OVERRIDE
}

fetch_manage() {
	# The release's helper, so a host whose kit predates it can upgrade and the
	# helper always matches the release.
	local version="$1"
	ssh "$HOST" "cd librepaper && curl -fsSL https://github.com/LibrePaper/librepaper/releases/download/$version/librepaper-deploy.tar.gz | tar xzO librepaper/manage > .manage.tmp && chmod 755 .manage.tmp && mv -f .manage.tmp manage"
}

write_candidates() {
	# The rendered files hold credentials. ~/librepaper is 0700 and keeps them
	# private; 444 lets the containers read them as uid 10001. ./manage upgrade
	# validates them with the new images before it swaps them into place.
	printf '%s' "$DEPLOY_CONFIG" | ssh "$HOST" 'umask 077; cat > librepaper/librepaper.toml.candidate.tmp && chmod 444 librepaper/librepaper.toml.candidate.tmp && mv -f librepaper/librepaper.toml.candidate.tmp librepaper/librepaper.toml.candidate'
	printf '%s' "$DEPLOY_RESTICPROFILE" | ssh "$HOST" 'umask 077; cat > librepaper/resticprofile.toml.candidate.tmp && chmod 444 librepaper/resticprofile.toml.candidate.tmp && mv -f librepaper/resticprofile.toml.candidate.tmp librepaper/resticprofile.toml.candidate'
}

write_site_caddy() {
	# Operator site blocks live in caddy/local.d, which upgrades never overwrite.
	# The site block also keeps the old install page URL working, redirecting it to local-app.
	printf '%s {\n\tencode zstd gzip\n\tredir /install.html /local-app.html permanent\n\troot * /srv/site\n\tfile_server\n}\n\n%s {\n\tredir https://%s{uri} permanent\n}\n' "$SITE" "$REDIRECTS" "$SITE" |
		ssh "$HOST" 'umask 022; mkdir -p librepaper/caddy/local.d; cat > librepaper/caddy/local.d/librepaper-org.caddy.tmp && chmod 644 librepaper/caddy/local.d/librepaper-org.caddy.tmp && mv -f librepaper/caddy/local.d/librepaper-org.caddy.tmp librepaper/caddy/local.d/librepaper-org.caddy'
}

reload_caddy() {
	# The Caddyfile imports caddy/local.d/*.caddy; a reload picks up a new site block without a restart.
	ssh "$HOST" 'cd librepaper && docker compose exec -T caddy caddy reload --config /etc/caddy/Caddyfile --adapter caddyfile'
}

site_build() {
	step "Site: make site (app links point at https://$APP)"
	LIBREPAPER_APP_ORIGIN="https://$APP" make site
	ok "built docs/_site"
}

site_sync() {
	step "Site: docs/_site/ -> $HOST:librepaper/site/"
	rsync -a --delete --out-format='    %n' docs/_site/ "$HOST:librepaper/site/"
	ok "synced"
}

check_production_dns() {
	step "DNS: every name -> the address of $SITE"
	local ip name names=0
	ip=$(dig +short "$SITE" | tail -n 1)
	[ -n "$ip" ] || die "$SITE does not resolve"
	for name in "$SITE" "$APP" "$DOCS" "$ADMIN_NAME" ${REDIRECTS//,/}; do
		[ "$(dig +short "$name" | tail -n 1)" = "$ip" ] || die "$name does not resolve to $ip yet: add its A record at Hover"
		names=$((names + 1))
	done
	ok "$names names -> $ip"
}

RENDERED_KEYS=0
# render FILE TARGET fills each @LIBREPAPER_NAME@ in FILE from the key of the
# same name in keys.yaml and sets the global TARGET to the result. The value
# is escaped for a TOML basic string; it is never printed.
render() {
	local file="$1" target="$2" text placeholder name value escaped placeholders
	text=$(<"$file")
	text+=$'\n'
	placeholders=$(grep -oE '@LIBREPAPER_[A-Z0-9_]+@' "$file" | sort -u || true)
	for placeholder in $placeholders; do
		name="${placeholder#@}"
		name="${name%@}"
		value=$(required_key "$name")
		[[ ! "$value" =~ [[:cntrl:]] ]] || die "$name in tools/deploy/keys.yaml contains a control character"
		escaped="${value//\\/\\\\}"
		escaped="${escaped//\"/\\\"}"
		text=${text//"$placeholder"/"$escaped"}
		RENDERED_KEYS=$((RENDERED_KEYS + 1))
	done
	printf -v "$target" '%s' "$text"
}

prepare_local() {
	check_production_dns

	step "Secrets from tools/deploy/keys.yaml"
	render tools/deploy/production.toml DEPLOY_CONFIG
	render tools/deploy/production-resticprofile.toml DEPLOY_RESTICPROFILE
	ok "$RENDERED_KEYS values decrypted from keys.yaml (not shown)"

	site_build
}

stage_host() {
	local version="$1"
	step "Helper: manage $version -> $HOST:librepaper/"
	fetch_manage "$version" || die "could not fetch manage from release $version"
	ok "fetched"

	step "Candidates: librepaper.toml and resticprofile.toml"
	write_candidates
	unset DEPLOY_CONFIG DEPLOY_RESTICPROFILE
	ok "staged both candidates (files 444)"

	step "Site, compose override and Caddy site blocks"
	site_sync
	write_compose_files
	write_site_caddy
	ok "$SITE serves docs/_site; $REDIRECTS -> https://$SITE"
}

usage() {
	cat <<'USAGE'
usage: tools/deploy/production <command>

  deploy [VERSION]   deploy a published release (canonical vMAJOR.MINOR.PATCH)
                     (VERSION defaults to v + the version in Cargo.toml)
  site               rebuild and upload the landing page and manual only (no release, no restart)
  verify             app, admin graphs, site, documents, redirect, operator URLs, and logs
  logs               follow the container logs
  help, -h, --help   show this message

Environment:
  HOST=ubuntu@librepaper.org   ssh target (use the IP before DNS resolves)
USAGE
}


verify() {
	step "App readiness: https://$APP/ready"
	local health_deadline=$((SECONDS + HEALTH_DEADLINE_SECONDS))
	local health_remaining connect_timeout
	local health_ok=false
	local first_fail=true

	while :; do
		health_remaining=$((health_deadline - SECONDS))
		[ "$health_remaining" -gt 0 ] || break
		connect_timeout="$HTTP_CONNECT_TIMEOUT"
		[ "$connect_timeout" -le "$health_remaining" ] || connect_timeout="$health_remaining"
		if curl --connect-timeout "$connect_timeout" --max-time "$health_remaining" -fs -o /dev/null "https://$APP/ready"; then
			health_ok=true
			break
		fi
		if [ "$first_fail" = true ]; then
			note "waiting for the server and its certificate (up to 2 minutes)"
			printf '    '
			first_fail=false
		fi
		printf .
		health_remaining=$((health_deadline - SECONDS))
		if [ "$health_remaining" -gt 0 ]; then sleep "$((health_remaining < 2 ? health_remaining : 2))"; fi
	done

	if [ "$health_ok" = false ]; then
		printf '\n'
		die "https://$APP/ready did not answer"
	fi
	if [ "$first_fail" = false ]; then
		printf '\n'
	fi
	ok "answers"
	verify_oauth_redirect github 'https://github.com/login/oauth/authorize?'
	verify_oauth_redirect google 'https://accounts.google.com/o/oauth2/v2/auth?'

	step "Admin graphs: ${ADMIN}data?points=10"
	local password config body api_code
	password=$(required_key LIBREPAPER_ADMIN_PASSWORD)
	config=$(mktemp)
	body=$(mktemp)
	VERIFY_TMP_FILES=("$config" "$body")
	trap cleanup_verify_tmp EXIT
	chmod 600 "$config" "$body"
	local escaped_password
	escaped_password=$(printf '%s' "$password" | sed 's/\\/\\\\/g; s/"/\\"/g')
	printf 'user = "admin:%s"\n' "$escaped_password" > "$config"
	unset password escaped_password
	local api_deadline=$((SECONDS + 90)) api_remaining waiting_note=false
	while :; do
		api_remaining=$((api_deadline - SECONDS))
		[ "$api_remaining" -gt 0 ] || break
		api_code=$(http_request --connect-timeout "$api_remaining" --max-time "$api_remaining" --config "$config" -sS -o "$body" -w '%{http_code}' "${ADMIN}data?points=10" || true)
		[ "$api_code" = 200 ] && break
		case "$api_code" in
			000|502|503)
				if [ "$waiting_note" = false ]; then
					note "waiting for the admin certificate and the first answer (up to 90 seconds)"
					waiting_note=true
				fi
				;;
			*) die "admin graphs endpoint returned HTTP $api_code" ;;
		esac
		api_remaining=$((api_deadline - SECONDS))
		if [ "$api_remaining" -gt 0 ]; then sleep "$((api_remaining < 2 ? api_remaining : 2))"; fi
	done
	[ "$api_code" = 200 ] || die "admin graphs endpoint returned HTTP $api_code"
	local series_count
	series_count=$(grep -o '"name":' "$body" | wc -l)
	[ "$series_count" = 12 ] || die "admin graphs endpoint returned $series_count series, expected 12"
	ok "authenticated endpoint returns twelve series"
	local unauthenticated_code
	unauthenticated_code=$(http_request -sS -o /dev/null -w '%{http_code}' "${ADMIN}data?points=10" || true)
	[ "$unauthenticated_code" = 401 ] || die "unauthenticated admin endpoint returned HTTP $unauthenticated_code, expected 401"
	ok "unauthenticated endpoint is 401"
	for path in /api/status /metrics /data /graphs; do
		local private_code
		private_code=$(http_request -sS -o /dev/null -w '%{http_code}' "https://$APP$path" || true)
		if [ "$path" = /api/status ]; then
			[ "$private_code" = 403 ] || die "https://$APP$path returned HTTP $private_code, expected 403"
		elif [ "$path" = /metrics ]; then
			case "$private_code" in 404|421) ;; *) die "https://$APP$path is public (HTTP $private_code)" ;; esac
		else
			[ "$private_code" = 404 ] || die "https://$APP$path returned HTTP $private_code, expected 404"
		fi
	done
	ok "app origin does not serve graphs or data, admin endpoint is 401, metrics and status are private"
	cleanup_verify_tmp
	VERIFY_TMP_FILES=()
	trap - EXIT

	step "Site: https://$SITE"
	http_request -fs -o /dev/null "https://$SITE/what.html" || die "https://$SITE/what.html did not answer: is the site uploaded?"
	ok "landing page and manual answer"

	step "Documents: https://$DOCS"
	local code
	code=$(http_request -s -o /dev/null -w '%{http_code}' "https://$DOCS/")
	if [ "$code" = "000" ]; then
		die "https://$DOCS did not answer"
	elif [ "$code" = "421" ]; then
		die "the server does not take $DOCS as its documents host (421)"
	else
		ok "answers (HTTP $code; it has no page at its root)"
	fi

	step "Redirect: https://librepaper.com"
	local location
	location=$(http_request -sI https://librepaper.com | tr -d '\r' | awk 'tolower($1)=="location:" {print $2}')
	if [ "$location" = "https://$SITE/" ]; then
		ok "-> $location"
	else
		die "librepaper.com redirects to '${location}', expected https://$SITE/"
	fi

	step "Operator additions: caddy/local.d/check-urls"
	local url urls
	urls=$(ssh "$HOST" 'cat librepaper/caddy/local.d/check-urls 2>/dev/null' || true)
	if [ -z "$urls" ]; then
		note "none listed"
	else
		while IFS= read -r url; do
			[[ "$url" =~ ^[[:space:]]*(#|$) ]] && continue
			if http_request -fs -o /dev/null "$url"; then
				ok "$url answers"
			else
				printf '    %s%s did not answer%s\n' "$red" "$url" "$reset"
			fi
		done <<< "$urls"
	fi

	step "Last 50 log lines"
	ssh "$HOST" 'cd librepaper && docker compose logs --tail 50'
}

verify_oauth_redirect() {
	local provider="$1" expected="$2" result code location
	if ! result=$(http_request -s -o /dev/null -w '%{http_code}\t%{redirect_url}' "https://$APP/auth/login/$provider"); then
		die "could not check the $provider OAuth redirect at https://$APP/auth/login/$provider"
	fi
	IFS=$'\t' read -r code location <<< "$result"
	if [ "$code" != "302" ] || [[ "$location" != "$expected"* ]]; then
		die "$provider OAuth route did not redirect to its expected authorization endpoint (HTTP $code)"
	fi
	ok "$provider OAuth redirect answers"
}

deploy() {
	local version="${1:-v$(sed -n 's/^version = "\(.*\)"/\1/p' Cargo.toml | head -n 1)}"
	validate_release_version "$version"

	printf '%sDeploying %s to %s%s\n' "$bold" "$version" "$HOST" "$reset"

	step "Release $version"
	http_request -fsIL -o /dev/null "https://github.com/LibrePaper/librepaper/releases/download/$version/$ASSET" || die "release $version has no $ASSET"
	ok "found $ASSET"

	prepare_local
	stage_host "$version"

	step "Upgrade: ./manage upgrade $version"
	note "backs up, checks the candidates with the new images, then switches"
	ssh "$HOST" "cd librepaper && ./manage upgrade $version" ||
		die "upgrade to $version failed; if validation failed nothing was switched; run ./manage status on $HOST"
	ok "running"

	step "Cleanup"
	ssh "$HOST" 'docker image prune -f'
	ok "removed replaced images"

	verify

	printf '\n%sDone: %s is live. Site https://%s, app https://%s (%ss)%s\n' "$green$bold" "$version" "$SITE" "$APP" "$SECONDS" "$reset"
}

case "${1:-help}" in
	deploy)
		deploy "${2:-}"
		;;
	site)
		site_build
		site_sync
		step "Caddy site block"
		write_site_caddy
		reload_caddy || die "caddy reload failed on $HOST; the uploaded pages are live under the previous block"
		ok "$SITE block installed and Caddy reloaded"
		step "Site: https://$SITE"
		http_request -fs -o /dev/null "https://$SITE/what.html" || die "https://$SITE/what.html did not answer: is the site uploaded?"
		ok "landing page and manual answer"
		printf '\n%sDone: site updated at https://%s (%ss)%s\n' "$green$bold" "$SITE" "$SECONDS" "$reset"
		;;
	verify)
		verify
		;;
	logs)
		step "Following logs on $HOST (Ctrl-C to stop)"
		ssh -t "$HOST" 'cd librepaper && docker compose logs -f --tail 100'
		;;
	help | -h | --help)
		usage
		;;
	*)
		usage >&2
		exit 2
		;;
esac
