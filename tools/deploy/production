#!/usr/bin/env bash
# Deploy the official instance at librepaper.org. Secrets come from
# tools/deploy/keys.yaml (SOPS); runbook encrypted in tools/deploy/runbook.enc.
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/../.."

HOST="${HOST:-ubuntu@librepaper-vps}"
ADDRESSES="${ADDRESSES:-15.235.24.221}"  # the server's public addresses (space-separated), independent of DNS
SITE=librepaper.org       # landing page and manual, from docs/_site (make site)
APP=app.librepaper.org    # the application: origin in tools/deploy/production.toml
DOCS=docs.librepaper.org  # published documents: origin in tools/deploy/production.toml
REDIRECTS='www.librepaper.org, librepaper.com, www.librepaper.com'
ASSET=librepaper-x86_64-unknown-linux-musl.tar.xz
ADMIN=https://admin.librepaper.org/  # operator console: origin in tools/deploy/production.toml
ADMIN_NAME=admin.librepaper.org  # hostname extracted from ADMIN
HTTP_CONNECT_TIMEOUT=5
HTTP_REQUEST_TIMEOUT=15
HEALTH_DEADLINE_SECONDS=120
REPLICA_BUCKET=librepaper-backups-replica-0001  # provider-side copy of the backups; only a laptop key can read it

if [ -t 1 ]; then bold=$'\e[1m' green=$'\e[32m' red=$'\e[31m' dim=$'\e[2m' reset=$'\e[0m'; else bold='' green='' red='' dim='' reset=''; fi
step() { printf '\n%s==> %s%s\n' "$bold" "$*" "$reset"; }
ok() { printf '    %s%s%s\n' "$green" "$*" "$reset"; }
note() { printf '    %s%s%s\n' "$dim" "$*" "$reset"; }

die() { printf '%sdeploy-production: %s%s\n' "$red" "$*" "$reset" >&2; exit 1; }
http_request() {
	curl --connect-timeout "$HTTP_CONNECT_TIMEOUT" --max-time "$HTTP_REQUEST_TIMEOUT" "$@"
}
# keys.yaml is encrypted to age. SOPS_AGE_KEY_CMD would ask for the identity's
# passphrase on every key, so unlock_identity asks once and keeps the identity
# in a shell variable that is never exported: only sops receives it.
AGE_IDENTITY=
unlock_identity() {
	[ -z "$AGE_IDENTITY" ] && [ -n "${SOPS_AGE_KEY_CMD:-}" ] || return 0
	AGE_IDENTITY=$(eval "$SOPS_AGE_KEY_CMD") || die "could not unlock the age identity (SOPS_AGE_KEY_CMD)"
}
key() {
	if [ -n "$AGE_IDENTITY" ]; then
		SOPS_AGE_KEY="$AGE_IDENTITY" SOPS_AGE_KEY_CMD= sops --decrypt --extract "[\"$1\"]" tools/deploy/keys.yaml
	else
		sops --decrypt --extract "[\"$1\"]" tools/deploy/keys.yaml
	fi
}
required_key() {
	local name="$1" value
	if ! value=$(key "$name" 2>/dev/null); then
		die "could not decrypt required key $name in tools/deploy/keys.yaml"
	fi
	if [[ ! "$value" =~ [^[:space:]] ]] || [[ "${value,,}" =~ ^[[:space:]]*(null|~)[[:space:]]*$ ]]; then
		die "required key $name in tools/deploy/keys.yaml is empty or null"
	fi
	printf '%s' "$value"
}

validate_release_version() {
	local version="$1" major minor patch
	if [[ ! "$version" =~ ^v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$ ]]; then
		die "release version must be a canonical tag such as v0.0.24"
	fi
	major="${BASH_REMATCH[1]}"
	minor="${BASH_REMATCH[2]}"
	patch="${BASH_REMATCH[3]}"
	if (( major == 0 && minor == 0 && patch < 24 )); then
		die "production deployment requires v0.0.24 or later: older releases do not know the squashed migration history production now records"
	fi
}

write_compose_files() {
	# Compose appends the volumes of an override to those of compose.yaml, so
	# only the mounts that are specific to this host belong here.
	#
	# The app and backup containers log to the host's journal. Every deploy
	# recreates both, and Docker deletes a container's own logs with it. The
	# journal keeps them. A changed driver replaces the options in compose.yaml
	# instead of merging with them, so max-size never reaches journald. Read
	# them with: sudo journalctl -t librepaper-librepaper-1 --since "1 hour ago"
	ssh "$HOST" 'umask 022; cat > librepaper/compose.override.yaml.tmp && chmod 644 librepaper/compose.override.yaml.tmp && mv -f librepaper/compose.override.yaml.tmp librepaper/compose.override.yaml' <<'OVERRIDE'
services:
  caddy:
    volumes:
      - ./site:/srv/site:ro
  librepaper:
    logging:
      driver: journald
      options:
        tag: "{{.Name}}"
  backup:
    logging:
      driver: journald
      options:
        tag: "{{.Name}}"
OVERRIDE
}

fetch_kit() {
	# The release's kit, so a host whose kit predates it can upgrade and the
	# helper always matches the release. The kit is verified on the laptop
	# before the host sees it. The host installs manage from that same file.
	local version="$1" dir file
	dir=$(mktemp -d)
	trap "rm -rf -- '$dir'" EXIT
	file="$dir/librepaper-deploy.tar.gz"
	gh release download "$version" --repo LibrePaper/librepaper --pattern librepaper-deploy.tar.gz --dir "$dir" || die "could not download the kit for $version from release $version"
	gh attestation verify "$file" --repo LibrePaper/librepaper --signer-workflow LibrePaper/librepaper/.github/workflows/publish-docker.yml || die "the kit for $version has no valid attestation from the release workflow and nothing was changed"
	# Only a verified kit reaches the host, and only the production host gets it.
	check_ssh_target
	ssh "$HOST" 'umask 077; cd librepaper && cat > .kit.tar.gz.tmp && mv -f .kit.tar.gz.tmp .kit.tar.gz' < "$file"
	ssh "$HOST" 'cd librepaper && tar xzOf .kit.tar.gz librepaper/manage > .manage.tmp && chmod 755 .manage.tmp && mv -f .manage.tmp manage'
}

write_candidates() {
	# The rendered files hold credentials. ~/librepaper is 0700 and keeps them
	# private; 444 lets the containers read them as uid 10001. ./manage upgrade
	# validates them with the new images before it swaps them into place.
	printf '%s' "$DEPLOY_CONFIG" | ssh "$HOST" 'umask 077; cat > librepaper/librepaper.toml.candidate.tmp && chmod 444 librepaper/librepaper.toml.candidate.tmp && mv -f librepaper/librepaper.toml.candidate.tmp librepaper/librepaper.toml.candidate'
	printf '%s' "$DEPLOY_RESTICPROFILE" | ssh "$HOST" 'umask 077; cat > librepaper/resticprofile.toml.candidate.tmp && chmod 444 librepaper/resticprofile.toml.candidate.tmp && mv -f librepaper/resticprofile.toml.candidate.tmp librepaper/resticprofile.toml.candidate'
}

write_site_caddy() {
	# Operator site blocks live in caddy/local.d, which upgrades never overwrite.
	# The site block also keeps the old install page URLs working, redirecting them to desktop-app.
	# The site block and redirect block also set security headers.
	local csp="frame-ancestors 'none'; base-uri 'none'; object-src 'none'; form-action 'self'"
	printf '%s {\n\tencode zstd gzip\n\theader {\n\t\tStrict-Transport-Security "max-age=31536000; includeSubDomains"\n\t\tX-Content-Type-Options nosniff\n\t\tReferrer-Policy strict-origin-when-cross-origin\n\t\tContent-Security-Policy "%s"\n\t}\n\tredir /install.html /desktop-app.html permanent\n\tredir /local-app.html /desktop-app.html permanent\n\troot * /srv/site\n\tfile_server\n}\n\n%s {\n\theader Strict-Transport-Security "max-age=31536000; includeSubDomains"\n\tredir https://%s{uri} permanent\n}\n' "$SITE" "$csp" "$REDIRECTS" "$SITE" |
		ssh "$HOST" 'umask 022; mkdir -p librepaper/caddy/local.d; cat > librepaper/caddy/local.d/librepaper-org.caddy.tmp && chmod 644 librepaper/caddy/local.d/librepaper-org.caddy.tmp && mv -f librepaper/caddy/local.d/librepaper-org.caddy.tmp librepaper/caddy/local.d/librepaper-org.caddy'
}

reload_caddy() {
	# The Caddyfile imports caddy/local.d/*.caddy; a reload picks up a new site block without a restart.
	ssh "$HOST" 'cd librepaper && docker compose exec -T caddy caddy reload --config /etc/caddy/Caddyfile --adapter caddyfile'
}

site_build() {
	step "Site: make site (app links point at https://$APP)"
	LIBREPAPER_APP_ORIGIN="https://$APP" make site
	ok "built docs/_site"
}

site_sync() {
	step "Site: docs/_site/ -> $HOST:librepaper/site/"
	rsync -a --delete --out-format='    %n' docs/_site/ "$HOST:librepaper/site/"
	ok "synced"
}

in_addresses() {
	case " $ADDRESSES " in
		*" $1 "*) return 0 ;;
	esac
	return 1
}

# dns_addresses TYPE NAME prints the A or AAAA addresses of NAME, one per line.
# dig also prints the target of a CNAME first; only address lines are kept.
dns_addresses() {
	local type="$1" name="$2" line
	while IFS= read -r line; do
		case "$type" in
			A) [[ "$line" =~ ^[0-9]+(\.[0-9]+){3}$ ]] || continue ;;
			AAAA) [[ "$line" == *:* && "$line" =~ ^[0-9A-Fa-f:.]+$ ]] || continue ;;
		esac
		printf '%s\n' "$line"
	done < <(dig +short "$type" "$name")
}

# check_dns_name NAME dies unless NAME has an A record and every A and AAAA
# address it returns is in ADDRESSES.
check_dns_name() {
	local name="$1" address
	[ -n "$(dns_addresses A "$name")" ] || die "$name has no A record: add it at Hover"
	while IFS= read -r address; do
		[ -n "$address" ] || continue
		in_addresses "$address" || die "$name resolves to $address, which is not in ADDRESSES ($ADDRESSES): fix the record at Hover"
	done < <(dns_addresses A "$name"; dns_addresses AAAA "$name")
}

check_production_dns() {
	step "DNS: every name -> $ADDRESSES"
	local name names=0
	for name in "$SITE" "$APP" "$DOCS" "$ADMIN_NAME" ${REDIRECTS//,/}; do
		check_dns_name "$name"
		names=$((names + 1))
	done
	ok "$names names -> $ADDRESSES"
}

# check_ssh_target dies unless the machine behind HOST owns one of ADDRESSES,
# so a tailnet name or a stale address never deploys to the wrong server.
check_ssh_target() {
	step "SSH: $HOST owns one of $ADDRESSES"
	local address
	while IFS= read -r address; do
		if in_addresses "$address"; then
			ok "$HOST has $address"
			return 0
		fi
	done < <(ssh "$HOST" "ip -o addr show scope global | awk '{print \$4}' | cut -d/ -f1")
	die "$HOST has none of ADDRESSES ($ADDRESSES): set HOST to the production server"
}

# host_checks prints a script for the server. Each output line is "ok", "warn"
# or "fail", a tab, and what was checked. Paths are relative to the login
# directory, like every other remote command here.
host_checks() {
	cat <<'REMOTE'
set -u
say() { printf '%s\t%s\n' "$1" "$2"; }
if conf=$(sudo -n sshd -T 2>/dev/null); then
	for want in 'passwordauthentication no' 'kbdinteractiveauthentication no' 'pubkeyauthentication yes'; do
		if grep -qx "$want" <<<"$conf"; then say ok "sshd: $want"; else say fail "sshd: expected $want"; fi
	done
	if grep -qxE 'permitrootlogin (no|prohibit-password)' <<<"$conf"; then say ok "sshd: root cannot log in with a password"; else say fail "sshd: root can log in with a password"; fi
else
	say warn "sshd -T needs a sudo password, so sshd settings were not checked"
fi
extra=$(ss -Hltnu | awk '{print $1, $5}' |
	grep -vE ' (127\.|\[::1\]|\[fd7a:115c:a1e0:|100\.)' |
	grep -vE '^tcp (0\.0\.0\.0|\[::\]):(80|443)$|^tcp 0\.0\.0\.0:22$|^udp (0\.0\.0\.0|\[::\]):41641$|^udp [0-9.]+%[a-z0-9]+:68$' || true)
if [ -z "$extra" ]; then say ok "listening: only SSH on IPv4, 80, 443 and Tailscale"; else say fail "unexpected listeners: $(tr '\n' ' ' <<<"$extra")"; fi
if [ "$(systemctl is-enabled unattended-upgrades 2>/dev/null)" = enabled ]; then say ok "unattended upgrades enabled"; else say fail "unattended upgrades are not enabled"; fi
if [ -f /var/run/reboot-required ]; then say warn "a reboot is pending"; else say ok "no reboot pending"; fi
mode=$(stat -c %a librepaper 2>/dev/null || echo missing)
if [ "$mode" = 700 ]; then say ok "librepaper/ is 700"; else say fail "librepaper/ is $mode, expected 700"; fi
used=$(df --output=pcent / | tail -1 | tr -dc 0-9)
if [ "${used:-0}" -lt 80 ]; then say ok "disk ${used}% used"; else say warn "disk ${used}% used"; fi
REMOTE
}

check_host() {
	local status line code fails=0
	step "Host: $HOST"
	while IFS=$'\t' read -r status line; do
		case "$status" in
			ok) ok "$line" ;;
			warn) note "warning: $line" ;;
			*) printf '    %s%s%s\n' "$red" "$line" "$reset"; fails=$((fails + 1)) ;;
		esac
	done < <(ssh "$HOST" "$(host_checks)")
	step "Admin console at the public address"
	code=$(http_request -s -o /dev/null -w '%{http_code}' --resolve "$ADMIN_NAME:443:${ADDRESSES%% *}" "$ADMIN" || true)
	if [ "$code" = 403 ]; then
		ok "answers 403 off the tailnet"
	else
		printf '    %sanswers %s off the tailnet, expected 403%s\n' "$red" "$code" "$reset"
		fails=$((fails + 1))
	fi
	[ "$fails" -eq 0 ] || die "$fails host checks failed"
}

# check_replica reads the replica with the laptop-only read-only key. The key
# must be refused writes and allowed old versions, which a restore after an
# attack reads. Set READ_DATA=10% to also read that share of the data.
check_replica() {
	local endpoint region out status=0 newest age
	unlock_identity
	endpoint=$(required_key LIBREPAPER_BACKUPS_S3_ENDPOINT)
	region=$(required_key LIBREPAPER_BACKUPS_S3_REGION)
	case "$endpoint" in *://*) ;; *) endpoint="https://$endpoint" ;; esac
	AWS_ACCESS_KEY_ID=$(required_key LIBREPAPER_REPLICA_READONLY_S3_ACCESS_KEY_ID)
	AWS_SECRET_ACCESS_KEY=$(required_key LIBREPAPER_REPLICA_READONLY_S3_SECRET_ACCESS_KEY)
	RESTIC_PASSWORD=$(required_key LIBREPAPER_RESTIC_PASSWORD)
	export AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY RESTIC_PASSWORD AWS_DEFAULT_REGION="$region"
	export RESTIC_REPOSITORY="s3:$endpoint/$REPLICA_BUCKET/restic" RESTIC_CACHE_DIR="$HOME/.cache/librepaper-replica-restic"
	# Newer AWS CLIs send checksums that some S3 services reject.
	export AWS_REQUEST_CHECKSUM_CALCULATION=when_required AWS_RESPONSE_CHECKSUM_VALIDATION=when_required

	step "Replica: the read-only key cannot write"
	out=$(printf 'probe\n' | replica_s3 s3 cp - "s3://$REPLICA_BUCKET/security-readonly-probe" 2>&1) || status=$?
	if [ "$status" -eq 0 ]; then
		die "the read-only key wrote to $REPLICA_BUCKET: fix its policy, then delete every version of security-readonly-probe"
	fi
	case "$out" in *AccessDenied*) ok "write refused" ;; *) die "the write failed for another reason: $out" ;; esac

	step "Replica: the read-only key can list old versions"
	replica_s3 s3api list-object-versions --bucket "$REPLICA_BUCKET" --max-keys 1 >/dev/null ||
		die "the read-only key cannot list old versions; a restore after an attack needs s3:ListBucketVersions"
	ok "old versions listed"

	step "Replica: newest snapshot"
	newest=$(replica_restic snapshots --no-lock --latest 1 --json | python3 -c 'import json,sys; s=json.load(sys.stdin); print(max(x["time"] for x in s) if s else "")')
	[ -n "$newest" ] || die "no snapshots in the replica"
	age=$(( ($(date -u +%s) - $(date -u -d "$newest" +%s)) / 60 ))
	[ "$age" -le 120 ] || die "the newest snapshot is $age minutes old: replication may have stopped"
	ok "newest snapshot $newest ($age minutes old)"

	step "Replica: restic check"
	if [ -n "${READ_DATA:-}" ]; then
		replica_restic check --no-lock --read-data-subset "$READ_DATA"
	else
		replica_restic check --no-lock
	fi
	ok "check passed"
}

replica_s3() {
	local endpoint
	endpoint=$(required_key LIBREPAPER_BACKUPS_S3_ENDPOINT)
	case "$endpoint" in *://*) ;; *) endpoint="https://$endpoint" ;; esac
	if command -v aws >/dev/null; then aws --endpoint-url "$endpoint" "$@"; else nix shell nixpkgs#awscli2 --command aws --endpoint-url "$endpoint" "$@"; fi
}

replica_restic() {
	if command -v restic >/dev/null; then restic "$@"; else nix shell nixpkgs#restic --command restic "$@"; fi
}

RENDERED_KEYS=0
# render FILE TARGET fills each @LIBREPAPER_NAME@ in FILE from the key of the
# same name in keys.yaml and sets the global TARGET to the result. The value
# is escaped for a TOML basic string; it is never printed.
render() {
	local file="$1" target="$2" text placeholder name value escaped placeholders
	text=$(<"$file")
	text+=$'\n'
	placeholders=$(grep -oE '@LIBREPAPER_[A-Z0-9_]+@' "$file" | sort -u || true)
	for placeholder in $placeholders; do
		name="${placeholder#@}"
		name="${name%@}"
		value=$(required_key "$name")
		[[ ! "$value" =~ [[:cntrl:]] ]] || die "$name in tools/deploy/keys.yaml contains a control character"
		escaped="${value//\\/\\\\}"
		escaped="${escaped//\"/\\\"}"
		text=${text//"$placeholder"/"$escaped"}
		RENDERED_KEYS=$((RENDERED_KEYS + 1))
	done
	printf -v "$target" '%s' "$text"
}

prepare_local() {
	check_production_dns

	step "Secrets from tools/deploy/keys.yaml"
	unlock_identity
	render tools/deploy/production.toml DEPLOY_CONFIG
	render tools/deploy/production-resticprofile.toml DEPLOY_RESTICPROFILE
	ok "$RENDERED_KEYS values decrypted from keys.yaml (not shown)"

	site_build
}

stage_host() {
	local version="$1"
	step "Kit: release $version -> $HOST:librepaper/"
	fetch_kit "$version"
	ok "verified the attestation, uploaded the kit and installed manage"

	step "Candidates: librepaper.toml and resticprofile.toml"
	write_candidates
	unset DEPLOY_CONFIG DEPLOY_RESTICPROFILE
	ok "staged both candidates (files 444)"

	step "Site, compose override and Caddy site blocks"
	site_sync
	write_compose_files
	write_site_caddy
	ok "$SITE serves docs/_site; $REDIRECTS -> https://$SITE"
}

usage() {
	cat <<'USAGE'
usage: tools/deploy/production <command>

  deploy [VERSION]   deploy a published release (canonical vMAJOR.MINOR.PATCH)
                     (VERSION defaults to v + the version in Cargo.toml)
  site               rebuild and upload the landing page and manual only (no release, no restart)
  verify             app, admin console, site, documents, redirect, operator URLs, and logs
  logs               follow the container logs
  check-host         sshd, listening ports, upgrades, reboot, kit permissions, disk, admin console off the tailnet
  check-replica      replica: writes refused, old versions readable, newest snapshot age, restic check
  help, -h, --help   show this message

Environment:
  HOST=ubuntu@librepaper-vps   ssh target (tailnet name; the public address works if SSH is open)
  ADDRESSES=15.235.24.221      server addresses DNS must resolve to (space-separated)
  READ_DATA=10%                check-replica also reads this share of the data
USAGE
}


verify() {
	step "App readiness: https://$APP/ready"
	local health_deadline=$((SECONDS + HEALTH_DEADLINE_SECONDS))
	local health_remaining connect_timeout
	local health_ok=false
	local first_fail=true

	while :; do
		health_remaining=$((health_deadline - SECONDS))
		[ "$health_remaining" -gt 0 ] || break
		connect_timeout="$HTTP_CONNECT_TIMEOUT"
		[ "$connect_timeout" -le "$health_remaining" ] || connect_timeout="$health_remaining"
		if curl --connect-timeout "$connect_timeout" --max-time "$health_remaining" -fs -o /dev/null "https://$APP/ready"; then
			health_ok=true
			break
		fi
		if [ "$first_fail" = true ]; then
			note "waiting for the server and its certificate (up to 2 minutes)"
			printf '    '
			first_fail=false
		fi
		printf .
		health_remaining=$((health_deadline - SECONDS))
		if [ "$health_remaining" -gt 0 ]; then sleep "$((health_remaining < 2 ? health_remaining : 2))"; fi
	done

	if [ "$health_ok" = false ]; then
		printf '\n'
		die "https://$APP/ready did not answer"
	fi
	if [ "$first_fail" = false ]; then
		printf '\n'
	fi
	ok "answers"
	verify_oauth_redirect github 'https://github.com/login/oauth/authorize?'
	verify_oauth_redirect google 'https://accounts.google.com/o/oauth2/v2/auth?'

	step "Admin console: ${ADMIN}"
	local admin_deadline=$((SECONDS + 90)) admin_remaining admin_result admin_code admin_location waiting_note=false
	while :; do
		admin_remaining=$((admin_deadline - SECONDS))
		[ "$admin_remaining" -gt 0 ] || break
		admin_result=$(http_request --connect-timeout "$admin_remaining" --max-time "$admin_remaining" -sS -o /dev/null -w '%{http_code} %{redirect_url}' "$ADMIN" || true)
		admin_code="${admin_result%% *}"
		case "$admin_code" in
			000|502|503)
				if [ "$waiting_note" = false ]; then
					note "waiting for the admin certificate (up to 90 seconds)"
					waiting_note=true
				fi
				;;
			*) break ;;
		esac
		admin_remaining=$((admin_deadline - SECONDS))
		if [ "$admin_remaining" -gt 0 ]; then sleep "$((admin_remaining < 2 ? admin_remaining : 2))"; fi
	done
	admin_location=""
	if [[ "$admin_result" == *" "* ]]; then admin_location="${admin_result#* }"; fi
	if [ "$admin_code" != 302 ] || [[ "$admin_location" != "https://github.com/login/oauth/authorize?"* || "$admin_location" != *"redirect_uri=https%3A%2F%2F${ADMIN_NAME}%2Fauth%2Fcallback"* ]]; then
		die "admin console answered HTTP $admin_code redirecting to '$admin_location', expected 302 to GitHub sign-in with redirect_uri for https://$ADMIN_NAME/auth/callback"
	fi
	ok "a visitor is sent to GitHub sign-in"
	local unauthenticated_code
	unauthenticated_code=$(http_request -sS -o /dev/null -w '%{http_code}' "${ADMIN}data?points=10" || true)
	[ "$unauthenticated_code" = 401 ] || die "unauthenticated admin endpoint returned HTTP $unauthenticated_code, expected 401"
	ok "unauthenticated data endpoint is 401"
	for path in /api/status /metrics /data /graphs; do
		local private_code
		private_code=$(http_request -sS -o /dev/null -w '%{http_code}' "https://$APP$path" || true)
		if [ "$path" = /api/status ]; then
			[ "$private_code" = 403 ] || die "https://$APP$path returned HTTP $private_code, expected 403"
		elif [ "$path" = /metrics ]; then
			case "$private_code" in 404|421) ;; *) die "https://$APP$path is public (HTTP $private_code)" ;; esac
		else
			[ "$private_code" = 404 ] || die "https://$APP$path returned HTTP $private_code, expected 404"
		fi
	done
	ok "app origin does not serve graphs or data, metrics and status are private"

	step "Site: https://$SITE"
	http_request -fs -o /dev/null "https://$SITE/what.html" || die "https://$SITE/what.html did not answer: is the site uploaded?"
	ok "landing page and manual answer"

	step "Documents: https://$DOCS"
	local code
	code=$(http_request -s -o /dev/null -w '%{http_code}' "https://$DOCS/")
	if [ "$code" = "000" ]; then
		die "https://$DOCS did not answer"
	elif [ "$code" = "421" ]; then
		die "the server does not take $DOCS as its documents host (421)"
	else
		ok "answers (HTTP $code; it has no page at its root)"
	fi

	step "Redirect: https://librepaper.com"
	local location
	location=$(http_request -sI https://librepaper.com | tr -d '\r' | awk 'tolower($1)=="location:" {print $2}')
	if [ "$location" = "https://$SITE/" ]; then
		ok "-> $location"
	else
		die "librepaper.com redirects to '${location}', expected https://$SITE/"
	fi

	step "Operator additions: caddy/local.d/check-urls"
	local url urls
	urls=$(ssh "$HOST" 'cat librepaper/caddy/local.d/check-urls 2>/dev/null' || true)
	if [ -z "$urls" ]; then
		note "none listed"
	else
		while IFS= read -r url; do
			[[ "$url" =~ ^[[:space:]]*(#|$) ]] && continue
			if http_request -fs -o /dev/null "$url"; then
				ok "$url answers"
			else
				printf '    %s%s did not answer%s\n' "$red" "$url" "$reset"
			fi
		done <<< "$urls"
	fi

	step "Last 50 log lines"
	ssh "$HOST" 'cd librepaper && docker compose logs --tail 50'
}

verify_oauth_redirect() {
	local provider="$1" expected="$2" result code location
	if ! result=$(http_request -s -o /dev/null -w '%{http_code}\t%{redirect_url}' "https://$APP/auth/login/$provider"); then
		die "could not check the $provider OAuth redirect at https://$APP/auth/login/$provider"
	fi
	IFS=$'\t' read -r code location <<< "$result"
	if [ "$code" != "302" ] || [[ "$location" != "$expected"* ]]; then
		die "$provider OAuth route did not redirect to its expected authorization endpoint (HTTP $code)"
	fi
	ok "$provider OAuth redirect answers"
}

deploy() {
	local version="${1:-v$(sed -n 's/^version = "\(.*\)"/\1/p' Cargo.toml | head -n 1)}"
	validate_release_version "$version"
	command -v gh >/dev/null 2>&1 || die "gh is needed to verify the release kit: install the GitHub CLI from https://cli.github.com"

	printf '%sDeploying %s to %s%s\n' "$bold" "$version" "$HOST" "$reset"

	step "Release $version"
	http_request -fsIL -o /dev/null "https://github.com/LibrePaper/librepaper/releases/download/$version/$ASSET" || die "release $version has no $ASSET"
	ok "found $ASSET"

	prepare_local
	stage_host "$version"

	step "Upgrade: ./manage upgrade $version"
	note "backs up, checks the candidates with the new images, then switches"
	ssh "$HOST" "cd librepaper && LIBREPAPER_KIT=.kit.tar.gz ./manage upgrade $version" ||
		die "upgrade to $version failed; if validation failed nothing was switched; run ./manage status on $HOST"
	ok "running"

	step "Cleanup"
	ssh "$HOST" 'rm -f librepaper/.kit.tar.gz && docker image prune -f'
	ok "removed the kit and replaced images"

	verify

	printf '\n%sDone: %s is live. Site https://%s, app https://%s (%ss)%s\n' "$green$bold" "$version" "$SITE" "$APP" "$SECONDS" "$reset"
}

case "${1:-help}" in
	deploy)
		deploy "${2:-}"
		;;
	site)
		site_build
		site_sync
		step "Caddy site block"
		write_site_caddy
		reload_caddy || die "caddy reload failed on $HOST; the uploaded pages are live under the previous block"
		ok "$SITE block installed and Caddy reloaded"
		step "Site: https://$SITE"
		http_request -fs -o /dev/null "https://$SITE/what.html" || die "https://$SITE/what.html did not answer: is the site uploaded?"
		ok "landing page and manual answer"
		printf '\n%sDone: site updated at https://%s (%ss)%s\n' "$green$bold" "$SITE" "$SECONDS" "$reset"
		;;
	verify)
		verify
		;;
	logs)
		step "Following logs on $HOST (Ctrl-C to stop)"
		ssh -t "$HOST" 'cd librepaper && docker compose logs -f --tail 100'
		;;
	check-host)
		check_host
		;;
	check-replica)
		check_replica
		;;
	help | -h | --help)
		usage
		;;
	*)
		usage >&2
		exit 2
		;;
esac
