#!/usr/bin/env bash
# Deploy the official instance at librepaper.org. Secrets come from
# tools/deploy/keys.yaml (SOPS); runbook encrypted in tools/deploy/runbook.enc.
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/../.."

HOST="${HOST:-ubuntu@librepaper.org}"
SITE=librepaper.org       # landing page and manual, from docs/_site (make site)
APP=app.librepaper.org    # the application: origin in tools/deploy/production.toml
DOCS=docs.librepaper.org  # published documents: origin in tools/deploy/production.toml
REDIRECTS='www.librepaper.org, librepaper.com, www.librepaper.com'
ASSET=librepaper-x86_64-unknown-linux-musl.tar.xz
MONITORING=https://$APP/admin/monitoring/
HTTP_CONNECT_TIMEOUT=5
HTTP_REQUEST_TIMEOUT=15
HEALTH_DEADLINE_SECONDS=120
CADDY_RELOAD_TIMEOUT_SECONDS=30

# Paths on the host that the kit archive never contains and a deploy never replaces.
OPERATOR_PATHS=(
	'/librepaper.toml*'
	/resticprofile.toml
	/secrets
	/.env
	'/compose.override.yaml*'
	'/caddy/Caddyfile*'
	/caddy/local.d
	/monitoring/grafana_admin_password
	/site
)
# The image build context: in the repository, not needed on the host.
BUILD_ONLY_PATHS=(/Dockerfile /backup)

if [ -t 1 ]; then bold=$'\e[1m' green=$'\e[32m' red=$'\e[31m' dim=$'\e[2m' reset=$'\e[0m'; else bold='' green='' red='' dim='' reset=''; fi
step() { printf '\n%s==> %s%s\n' "$bold" "$*" "$reset"; }
ok() { printf '    %s%s%s\n' "$green" "$*" "$reset"; }
note() { printf '    %s%s%s\n' "$dim" "$*" "$reset"; }

die() { printf '%sdeploy-production: %s%s\n' "$red" "$*" "$reset" >&2; exit 1; }
http_request() {
	curl --connect-timeout "$HTTP_CONNECT_TIMEOUT" --max-time "$HTTP_REQUEST_TIMEOUT" "$@"
}
key() { sops --decrypt --extract "[\"$1\"]" tools/deploy/keys.yaml; }
required_key() {
	local name="$1" value
	if ! value=$(key "$name" 2>/dev/null); then
		die "could not decrypt required key $name in tools/deploy/keys.yaml"
	fi
	if [[ ! "$value" =~ [^[:space:]] ]] || [[ "${value,,}" =~ ^[[:space:]]*(null|~)[[:space:]]*$ ]]; then
		die "required key $name in tools/deploy/keys.yaml is empty or null"
	fi
	printf '%s' "$value"
}

validate_release_version() {
	local version="$1" major minor patch
	if [[ ! "$version" =~ ^v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$ ]]; then
		die "release version must be a canonical tag such as v0.0.21"
	fi
	major="${BASH_REMATCH[1]}"
	minor="${BASH_REMATCH[2]}"
	patch="${BASH_REMATCH[3]}"
	if (( major == 0 && minor == 0 && patch < 21 )); then
		die "production deployment requires v0.0.21 or later: older binaries lack /api/tls/ask, so Caddy would issue no certificates"
	fi
}

VERIFY_TMP_FILES=()
cleanup_verify_tmp() {
	if [ "${#VERIFY_TMP_FILES[@]}" -gt 0 ]; then rm -f -- "${VERIFY_TMP_FILES[@]}"; fi
}

write_secret_file() {
	local name="$1" value="$2" dir=secrets prepare='chmod 700 librepaper/secrets'
	case "$name" in
		github_client_id | github_client_secret | google_client_id | google_client_secret) ;;
		grafana_admin_password) dir=monitoring prepare=: ;;
		*) die "invalid production secret name" ;;
	esac
	# Secret bytes travel on stdin, never in SSH arguments or a shared env file.
	printf '%s' "$value" | ssh "$HOST" "umask 077; mkdir -p librepaper/$dir; $prepare; tmp=librepaper/$dir/.${name}.tmp; cat > \"\$tmp\" && chmod 444 \"\$tmp\" && mv -f \"\$tmp\" librepaper/$dir/$name"
}

write_compose_files() {
	# Compose reads .env on its own; this is how it remembers the monitoring profile.
	printf 'COMPOSE_PROFILES=monitoring\n' | ssh "$HOST" 'umask 022; cat > librepaper/.env.tmp && chmod 644 librepaper/.env.tmp && mv -f librepaper/.env.tmp librepaper/.env'
	# Compose appends the volumes of an override to those of compose.yaml, so
	# only the mounts that are specific to this host belong here.
	ssh "$HOST" 'umask 022; cat > librepaper/compose.override.yaml.tmp && chmod 644 librepaper/compose.override.yaml.tmp && mv -f librepaper/compose.override.yaml.tmp librepaper/compose.override.yaml' <<'OVERRIDE'
services:
  librepaper:
    volumes:
      - ./secrets:/run/secrets:ro
  caddy:
    volumes:
      - ./site:/srv/site:ro
OVERRIDE
}

write_config() {
	# This file holds literals and references to files under /run/secrets.
	# Stage it separately so the candidate binary can validate it before the
	# currently installed configuration is replaced.
	ssh "$HOST" 'umask 022; cat > librepaper/librepaper.toml.candidate.tmp && chmod 644 librepaper/librepaper.toml.candidate.tmp && mv -f librepaper/librepaper.toml.candidate.tmp librepaper/librepaper.toml.candidate' < tools/deploy/production.toml
}

install_config() {
	ssh "$HOST" 'cd librepaper && mv -f librepaper.toml.candidate librepaper.toml'
}

stage_caddy_config() {
	{
		cat deploy/caddy/Caddyfile
		printf '\n%s {\n\tencode zstd gzip\n\troot * /srv/site\n\tfile_server\n}\n\n%s {\n\tredir https://%s{uri} permanent\n}\n' "$SITE" "$REDIRECTS" "$SITE"
	} | ssh "$HOST" 'umask 022; mkdir -p librepaper/caddy; cat > librepaper/caddy/Caddyfile.candidate.tmp && chmod 644 librepaper/caddy/Caddyfile.candidate.tmp && mv -f librepaper/caddy/Caddyfile.candidate.tmp librepaper/caddy/Caddyfile.candidate'
}

install_caddy_config() {
	ssh "$HOST" 'cd librepaper && mv -f caddy/Caddyfile.candidate caddy/Caddyfile'
}

site_build() {
	step "Site: make site (app links point at https://$APP)"
	LIBREPAPER_APP_ORIGIN="https://$APP" make site
	ok "built docs/_site"
}

site_sync() {
	step "Site: docs/_site/ -> $HOST:librepaper/site/"
	rsync -a --delete --out-format='    %n' docs/_site/ "$HOST:librepaper/site/"
	ok "synced"
}

check_production_dns() {
	step "DNS: every name -> the address of $SITE"
	local ip name names=0
	ip=$(dig +short "$SITE" | tail -n 1)
	[ -n "$ip" ] || die "$SITE does not resolve"
	for name in "$SITE" "$APP" "$DOCS" ${REDIRECTS//,/}; do
		[ "$(dig +short "$name" | tail -n 1)" = "$ip" ] || die "$name does not resolve to $ip yet: add its A record at Hover"
		names=$((names + 1))
	done
	ok "$names names -> $ip"
}

load_deployment_secrets() {
	DEPLOY_GITHUB_ID=$(required_key PRODUCTION_GITHUB_CLIENT_ID)
	DEPLOY_GITHUB_SECRET=$(required_key PRODUCTION_GITHUB_CLIENT_SECRET)
	DEPLOY_GOOGLE_ID=$(required_key PRODUCTION_GOOGLE_CLIENT_ID)
	DEPLOY_GOOGLE_SECRET=$(required_key PRODUCTION_GOOGLE_CLIENT_SECRET)
	DEPLOY_ADMIN_PASSWORD=$(required_key PRODUCTION_ADMIN_PASSWORD)
	ok "5 credentials decrypted (values not shown)"
}

install_deployment_secrets() {
	write_secret_file github_client_id "$DEPLOY_GITHUB_ID"
	write_secret_file github_client_secret "$DEPLOY_GITHUB_SECRET"
	write_secret_file google_client_id "$DEPLOY_GOOGLE_ID"
	write_secret_file google_client_secret "$DEPLOY_GOOGLE_SECRET"
	write_secret_file grafana_admin_password "$DEPLOY_ADMIN_PASSWORD"
	unset DEPLOY_GITHUB_ID DEPLOY_GITHUB_SECRET DEPLOY_GOOGLE_ID DEPLOY_GOOGLE_SECRET DEPLOY_ADMIN_PASSWORD
}

sync_deployment_files() {
	# Refresh the kit while leaving everything the operator owns alone. --delete
	# makes files the kit dropped disappear from the host; the P rules say, in
	# the command itself, that the operator paths are never deleted.
	local path args=()
	for path in "${OPERATOR_PATHS[@]}"; do
		args+=(--exclude="$path" --filter="P $path")
	done
	for path in "${BUILD_ONLY_PATHS[@]}"; do
		args+=(--exclude="$path")
	done
	rsync -a --delete "${args[@]}" --out-format='    %n' deploy/ "$HOST:librepaper/"
	rsync -a --ignore-existing deploy/resticprofile.toml "$HOST:librepaper/resticprofile.toml"
	# The archive's top directory is private; files inside stay readable for the containers.
	ssh "$HOST" 'chmod 700 librepaper'
}

pin_image_tag() {
	local version="$1"
	ssh "$HOST" "cd librepaper && sed -i -E 's#(ghcr.io/librepaper/librepaper(-backup)?):v[0-9]+\.[0-9]+\.[0-9]+#\1:$version#' compose.yaml" ||
		die "could not edit compose.yaml on $HOST"
	ssh "$HOST" "cd librepaper && test \"\$(grep -c -F -e 'ghcr.io/librepaper/librepaper:$version' -e 'ghcr.io/librepaper/librepaper-backup:$version' compose.yaml)\" = 2" ||
		die "compose.yaml on $HOST does not pin both images to $version"
	ok "compose.yaml pins both images to $version"
}

prepare_local() {
	check_production_dns

	step "Secrets from tools/deploy/keys.yaml"
	load_deployment_secrets

	site_build
}

stage_host() {
	local version="$1"
	step "Kit: deploy/ -> $HOST:librepaper/"
	sync_deployment_files
	ok "synced"
	site_sync
	pin_image_tag "$version"

	step "Credentials, .env and compose.override.yaml on the VPS"
	install_deployment_secrets
	write_compose_files
	ok "wrote four OAuth files (directory 700, files 444), the Grafana password, .env and compose.override.yaml"

	step "Candidates: librepaper.toml, and Caddy with the site and the redirects"
	write_config
	stage_caddy_config
	ok "staged librepaper.toml.candidate; $SITE serves docs/_site; $REDIRECTS -> https://$SITE"

	step "Candidates: check them with the image that will run them"
	validate_candidates
}

validate_candidates() {
	# Nothing here touches the installed files or the running stack. The
	# override already mounts ./secrets, so the OAuth file references resolve.
	if ! ssh "$HOST" 'cd librepaper && docker compose run --rm --no-deps -v ./librepaper.toml.candidate:/etc/librepaper/librepaper.toml:ro librepaper admin config check --config /etc/librepaper/librepaper.toml'; then
		die "the candidate binary cannot load librepaper.toml; the installed configuration and the running deployment were not touched"
	fi
	if ! ssh "$HOST" 'cd librepaper && docker compose run --rm --no-deps caddy caddy validate --config /etc/caddy/Caddyfile.candidate --adapter caddyfile'; then
		die "the candidate Caddy configuration is invalid; the installed configuration and the running deployment were not touched"
	fi
	ok "both candidates are valid"
}

install_candidates() {
	step "Install the checked configuration"
	install_config
	install_caddy_config
	ok "installed librepaper.toml and caddy/Caddyfile"
}

snapshot_host_files() {
	# TEMPORARY, with convert-database. Files only, no volumes, no site. An
	# earlier snapshot is kept: it is the state before the first sync.
	step "Snapshot: ~/librepaper -> $HOST:librepaper-convert/host-files-before.tar.gz"
	ssh "$HOST" 'mkdir -p -m 700 librepaper-convert && { [ -e librepaper-convert/host-files-before.tar.gz ] || tar czf librepaper-convert/host-files-before.tar.gz --exclude=librepaper/site -C . librepaper; }'
	ok "host files are saved (restore with tar xzf in the home directory, then docker compose up -d)"
}

usage() {
	cat <<'USAGE'
usage: tools/deploy/production <command>

  deploy [VERSION]   deploy a published release (canonical vMAJOR.MINOR.PATCH, v0.0.21+)
                     (VERSION defaults to v + the version in Cargo.toml)
  site               rebuild and upload the landing page and manual only (no release, no restart)
  verify             app, monitoring, site, documents, redirect, operator URLs, and logs
  logs               follow the container logs
  convert-database   TEMPORARY, deleted after production converts: stage the v0.0.21 kit,
                     save the host files, then run tools/deploy/convert-database.sh on the host
  help, -h, --help   show this message

Environment:
  HOST=ubuntu@librepaper.org   ssh target (use the IP before DNS resolves)
USAGE
}

monitoring_verify() {
	step "Monitoring: authenticated Grafana dashboard $MONITORING"
	local password config body headers api_code uid
	password=$(required_key PRODUCTION_ADMIN_PASSWORD)
	config=$(mktemp)
	body=$(mktemp)
	headers=$(mktemp)
	VERIFY_TMP_FILES=("$config" "$body" "$headers")
	trap cleanup_verify_tmp EXIT
	chmod 600 "$config" "$body"
	# Curl config keeps the credential out of argv and shell history. Escape
	# characters with meaning in curl's quoted config syntax.
	local escaped_password
	escaped_password=$(printf '%s' "$password" | sed 's/\\/\\\\/g; s/"/\\"/g')
	printf 'user = "admin:%s"\n' "$escaped_password" > "$config"
	unset password escaped_password
	local api_deadline=$((SECONDS + 60)) api_remaining waiting_note=false
	while :; do
		api_remaining=$((api_deadline - SECONDS))
		[ "$api_remaining" -gt 0 ] || break
		api_code=$(curl --connect-timeout "$api_remaining" --max-time "$api_remaining" --config "$config" -sS -o "$body" -w '%{http_code}' "${MONITORING}api/search?type=dash-db" || true)
		[ "$api_code" = 200 ] && break
		case "$api_code" in
			000|502|503)
				if [ "$waiting_note" = false ]; then
					note "waiting for Grafana to finish starting (up to 60 seconds)"
					waiting_note=true
				fi
				;;
			*) die "authenticated Grafana dashboard API returned HTTP $api_code" ;;
		esac
		api_remaining=$((api_deadline - SECONDS))
		if [ "$api_remaining" -gt 0 ]; then sleep "$((api_remaining < 2 ? api_remaining : 2))"; fi
	done
	[ "$api_code" = 200 ] || die "authenticated Grafana dashboard API returned HTTP $api_code"
	DASHBOARDS_JSON=$(cat "$body") node -e 'const d=JSON.parse(process.env.DASHBOARDS_JSON);process.exit(d.some(x=>x.type==="dash-db"&&x.uid)?0:1)' || die "Grafana has no provisioned dashboard"
	uid=$(DASHBOARDS_JSON=$(cat "$body") node -e 'const d=JSON.parse(process.env.DASHBOARDS_JSON);process.stdout.write(d.find(x=>x.type==="dash-db").uid)')
	ok "configured credentials can read the provisioned dashboard"

	local anonymous_code anonymous_location
	anonymous_code=$(http_request -sS -D "$headers" -o /dev/null -w '%{http_code}' "${MONITORING}d/$uid" || true)
	[ "$anonymous_code" = 302 ] || [ "$anonymous_code" = 303 ] || die "unauthenticated Grafana dashboard returned HTTP $anonymous_code, expected a login redirect"
	anonymous_location=$(tr -d '\r' < "$headers" | awk 'tolower($1)=="location:" {print $2}')
	case "$anonymous_location" in *login*) ;; *) die "Grafana unauthenticated redirect did not lead to login" ;; esac
	api_code=$(http_request -sS -o /dev/null -w '%{http_code}' "${MONITORING}api/search?type=dash-db" || true)
	[ "$api_code" = 401 ] || [ "$api_code" = 403 ] || die "unauthenticated Grafana API returned HTTP $api_code"
	ok "unauthenticated dashboard redirects to login and API access is denied"

	step "Monitoring: private endpoints and Prometheus history"
	for path in /metrics /api/status /api/v1/status/config /api/v1/targets; do
		local private_code
		private_code=$(http_request -sS -o /dev/null -w '%{http_code}' "https://$APP$path" || true)
		if [ "$path" = /api/status ]; then
			[ "$private_code" = 403 ] || die "https://$APP$path returned HTTP $private_code, expected 403"
		else
			case "$private_code" in 404|421) ;; *) die "https://$APP$path is public (HTTP $private_code)" ;; esac
		fi
	done
	local targets history snapshot now start prom_deadline=$((SECONDS + 60)) prom_remaining prom_attempts=0
	local prometheus_ok=false
	local prom_waiting_note=false
	while [ "$prom_attempts" -lt 30 ]; do
		prom_remaining=$((prom_deadline - SECONDS))
		[ "$prom_remaining" -gt 0 ] || break
		now=$(date +%s)
		start=$((now - 90))
		# Prometheus is internal-only. Run its API from inside the container and
		# return only JSON metadata to the local Node parser.
		local response
		response=$(timeout "$prom_remaining" ssh "$HOST" 'cd librepaper && docker compose exec -T prometheus sh -s' 2>/dev/null <<PROMETHEUS_API_EOF
targets=\$(wget -qO- 'http://127.0.0.1:9090/api/v1/targets?state=active') || exit 1
history=\$(wget -qO- 'http://127.0.0.1:9090/api/v1/query_range?query=up%7Bjob%3D%22librepaper%22%7D&start=$start&end=$now&step=15s') || exit 1
snapshot=\$(wget -qO- 'http://127.0.0.1:9090/api/v1/query?query=(librepaper_metrics_snapshot_success%3D%3D1%20and%20time%28%29-librepaper_metrics_snapshot_timestamp_seconds%3C60)%20and%20on%28%29%20(pg_up%3D%3D1)') || exit 1
printf '%s\n---LIBREPAPER-METRICS---\n%s\n---LIBREPAPER-METRICS---\n%s\n' "\$targets" "\$history" "\$snapshot"
PROMETHEUS_API_EOF
		) || response=''
		if [ -n "$response" ]; then
		targets=${response%%$'\n---LIBREPAPER-METRICS---\n'*}
		remainder=${response#*$'\n---LIBREPAPER-METRICS---\n'}
		history=${remainder%%$'\n---LIBREPAPER-METRICS---\n'*}
		snapshot=${remainder#*$'\n---LIBREPAPER-METRICS---\n'}
		if TARGETS_JSON="$targets" HISTORY_JSON="$history" SNAPSHOT_JSON="$snapshot" node -e 'const t=JSON.parse(process.env.TARGETS_JSON).data.activeTargets;const h=JSON.parse(process.env.HISTORY_JSON).data.result;const s=JSON.parse(process.env.SNAPSHOT_JSON).data.result;const expected=["librepaper","node","postgres"];const jobs=t.map(x=>x.labels&&x.labels.job);const healthy=t.length===expected.length&&t.every(x=>x.health==="up"&&expected.includes(x.labels&&x.labels.job))&&expected.every(x=>jobs.includes(x));const samples=h.some(x=>{const v=x.values||[];return v.length>=2&&v.slice(-2).every(y=>y[1]==="1")});const pgup=s.some(x=>x.value&&x.value[1]==="1");process.exit(healthy&&samples&&pgup?0:1)' 2>/dev/null; then
			prometheus_ok=true
			break
		fi
		fi
		if [ "$prom_waiting_note" = false ]; then
			note "waiting for Prometheus APIs, all scrape targets, recent samples, and a fresh snapshot (up to 60 seconds)"
			prom_waiting_note=true
		fi
		prom_attempts=$((prom_attempts + 1))
		prom_remaining=$((prom_deadline - SECONDS))
		if [ "$prom_remaining" -gt 0 ]; then sleep "$((prom_remaining < 2 ? prom_remaining : 2))"; fi
	done
	[ "$prometheus_ok" = true ] || die "Prometheus APIs, targets, LibrePaper sample history, snapshot, or pg_up are unhealthy"
	ok "all Prometheus targets are up; LibrePaper has two good samples, a fresh snapshot, and pg_up=1"

	step "Monitoring: provisioned dashboard $uid and panels"
	api_code=$(http_request --config "$config" -sS -o "$body" -w '%{http_code}' "${MONITORING}api/dashboards/uid/$uid" || true)
	[ "$api_code" = 200 ] || die "Grafana dashboard API returned HTTP $api_code for $uid"
	DASHBOARD_JSON=$(cat "$body") node -e 'const d=JSON.parse(process.env.DASHBOARD_JSON).dashboard;const p=d.panels||[];function valid(xs){return xs.every(x=>x.type&&x.title&&(!x.panels||valid(x.panels)))}process.exit(p.length&&valid(p)?0:1)' || die "provisioned Grafana dashboard has missing or invalid panels"
	ok "provisioned dashboard and panels are valid"
	cleanup_verify_tmp
	VERIFY_TMP_FILES=()
	trap - EXIT
}

verify() {
	step "App readiness: https://$APP/ready"
	local health_deadline=$((SECONDS + HEALTH_DEADLINE_SECONDS))
	local health_remaining connect_timeout
	local health_ok=false
	local first_fail=true

	while :; do
		health_remaining=$((health_deadline - SECONDS))
		[ "$health_remaining" -gt 0 ] || break
		connect_timeout="$HTTP_CONNECT_TIMEOUT"
		[ "$connect_timeout" -le "$health_remaining" ] || connect_timeout="$health_remaining"
		if curl --connect-timeout "$connect_timeout" --max-time "$health_remaining" -fs -o /dev/null "https://$APP/ready"; then
			health_ok=true
			break
		fi
		if [ "$first_fail" = true ]; then
			note "waiting for the server and its certificate (up to 2 minutes)"
			printf '    '
			first_fail=false
		fi
		printf .
		health_remaining=$((health_deadline - SECONDS))
		if [ "$health_remaining" -gt 0 ]; then sleep "$((health_remaining < 2 ? health_remaining : 2))"; fi
	done

	if [ "$health_ok" = false ]; then
		printf '\n'
		die "https://$APP/ready did not answer"
	fi
	if [ "$first_fail" = false ]; then
		printf '\n'
	fi
	ok "answers"
	verify_oauth_redirect github 'https://github.com/login/oauth/authorize?'
	verify_oauth_redirect google 'https://accounts.google.com/o/oauth2/v2/auth?'
	monitoring_verify

	step "Site: https://$SITE"
	http_request -fs -o /dev/null "https://$SITE/what.html" || die "https://$SITE/what.html did not answer: is the site uploaded?"
	ok "landing page and manual answer"

	step "Documents: https://$DOCS"
	local code
	code=$(http_request -s -o /dev/null -w '%{http_code}' "https://$DOCS/")
	if [ "$code" = "000" ]; then
		die "https://$DOCS did not answer"
	elif [ "$code" = "421" ]; then
		die "the server does not take $DOCS as its documents host (421)"
	else
		ok "answers (HTTP $code; it has no page at its root)"
	fi

	step "Redirect: https://librepaper.com"
	local location
	location=$(http_request -sI https://librepaper.com | tr -d '\r' | awk 'tolower($1)=="location:" {print $2}')
	if [ "$location" = "https://$SITE/" ]; then
		ok "-> $location"
	else
		die "librepaper.com redirects to '${location}', expected https://$SITE/"
	fi

	step "Operator additions: caddy/local.d/check-urls"
	local url urls
	urls=$(ssh "$HOST" 'cat librepaper/caddy/local.d/check-urls 2>/dev/null' || true)
	if [ -z "$urls" ]; then
		note "none listed"
	else
		while IFS= read -r url; do
			[[ "$url" =~ ^[[:space:]]*(#|$) ]] && continue
			if http_request -fs -o /dev/null "$url"; then
				ok "$url answers"
			else
				printf '    %s%s did not answer%s\n' "$red" "$url" "$reset"
			fi
		done <<< "$urls"
	fi

	step "Last 50 log lines"
	ssh "$HOST" 'cd librepaper && docker compose logs --tail 50'
}

verify_oauth_redirect() {
	local provider="$1" expected="$2" result code location
	if ! result=$(http_request -s -o /dev/null -w '%{http_code}\t%{redirect_url}' "https://$APP/auth/login/$provider"); then
		die "could not check the $provider OAuth redirect at https://$APP/auth/login/$provider"
	fi
	IFS=$'\t' read -r code location <<< "$result"
	if [ "$code" != "302" ] || [[ "$location" != "$expected"* ]]; then
		die "$provider OAuth route did not redirect to its expected authorization endpoint (HTTP $code)"
	fi
	ok "$provider OAuth redirect answers"
}

deploy() {
	local version="${1:-v$(sed -n 's/^version = "\(.*\)"/\1/p' Cargo.toml | head -n 1)}"
	validate_release_version "$version"

	printf '%sDeploying %s to %s%s\n' "$bold" "$version" "$HOST" "$reset"

	step "Release $version"
	http_request -fsIL -o /dev/null "https://github.com/LibrePaper/librepaper/releases/download/$version/$ASSET" || die "release $version has no $ASSET"
	ok "found $ASSET"

	prepare_local
	stage_host "$version"
	install_candidates

	step "Containers: pull and start $version"
	note "the server migrates the schema at startup; nothing is stopped by hand"
	ssh "$HOST" 'cd librepaper && docker compose pull'
	ssh "$HOST" 'cd librepaper && docker compose up -d --wait --wait-timeout 180'
	# Compose compares service definitions, not the bytes behind a bind mount: a
	# same-version deploy that only changed librepaper.toml, resticprofile.toml or
	# prometheus.yaml would otherwise leave the old inode in use.
	ssh "$HOST" 'cd librepaper && docker compose up -d --force-recreate --no-deps --wait --wait-timeout 180 librepaper backup prometheus'
	if ! timeout "$CADDY_RELOAD_TIMEOUT_SECONDS" ssh "$HOST" 'cd librepaper && docker compose exec -T caddy caddy reload --config /etc/caddy/Caddyfile --adapter caddyfile'; then
		die "Caddy configuration reload failed"
	fi
	ok "running"

	step "Cleanup"
	ssh "$HOST" 'docker image prune -f'
	ok "removed replaced images"

	verify

	printf '\n%sDone: %s is live. Site https://%s, app https://%s (%ss)%s\n' "$green$bold" "$version" "$SITE" "$APP" "$SECONDS" "$reset"
}

# TEMPORARY. Delete this function, its case entry, its usage line,
# tools/deploy/convert-database.sh and tools/test/deploy/convert.sh once
# production has been converted to the socket-trust kit.
#
# Stages the v0.0.21 kit without starting anything, saves the host files from
# before the sync, installs the checked candidates, then runs the conversion
# script on the host. The script must not install the candidates itself.
convert_database() {
	local version=v0.0.21 script=tools/deploy/convert-database.sh
	[ -f "$script" ] || die "$script is missing"

	printf '%sConverting the database on %s with the %s kit%s\n' "$bold" "$HOST" "$version" "$reset"

	prepare_local
	snapshot_host_files
	stage_host "$version"
	install_candidates

	step "Host script: $script"
	if ! ssh "$HOST" 'cd librepaper && bash -s' < "$script"; then
		die "$script failed. If it stopped before its transaction committed: cd ~ && tar xzf librepaper-convert/host-files-before.tar.gz && cd librepaper && docker compose up -d"
	fi
	ok "converted"

	verify

	printf '\n%sDone: the database is converted; %s is live at https://%s (%ss)%s\n' "$green$bold" "$version" "$APP" "$SECONDS" "$reset"
}

case "${1:-help}" in
	deploy)
		deploy "${2:-}"
		;;
	convert-database)
		convert_database
		;;
	site)
		site_build
		site_sync
		step "Site: https://$SITE"
		http_request -fs -o /dev/null "https://$SITE/what.html" || die "https://$SITE/what.html did not answer: is the site uploaded?"
		ok "landing page and manual answer"
		printf '\n%sDone: site updated at https://%s (%ss)%s\n' "$green$bold" "$SITE" "$SECONDS" "$reset"
		;;
	verify)
		verify
		;;
	logs)
		step "Following logs on $HOST (Ctrl-C to stop)"
		ssh -t "$HOST" 'cd librepaper && docker compose logs -f --tail 100'
		;;
	help | -h | --help)
		usage
		;;
	*)
		usage >&2
		exit 2
		;;
esac
