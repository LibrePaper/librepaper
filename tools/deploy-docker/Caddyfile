# The reader and the documents, on the two names the deployment was configured
# with. Caddy gets a certificate for each over HTTP-01, so both must already
# resolve here; no wildcard is needed, since the second name is a concrete one.
#
# Host is passed through unchanged -- Caddy's default, and a requirement: the
# server decides which of its two origins a request arrived on from that header
# alone, and answers 421 to a name it does not serve.
{
	email {$ACME_EMAIL}
}

{$DOMAIN}, docs.{$DOMAIN} {
	encode zstd gzip
	# Collaboration is a WebSocket; Caddy carries the upgrade itself.
	reverse_proxy librepaper:8080
}

# Other names for the same deployment, such as www or a second domain, must
# stop here: the server answers 421 to any host but DOMAIN and docs.DOMAIN.
# Give each a DNS record and send it to the reader:
#
# www.{$DOMAIN}, example.com, www.example.com {
#	redir https://{$DOMAIN}{uri} permanent
# }
