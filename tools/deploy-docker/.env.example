# Copy to .env beside compose.yaml. Values are read by docker compose, so write
# them bare, with no surrounding quotes.

# The release tag for the normal Dockerfile path. It must include both the
# metrics listener and TOML configuration support. See README.md before using
# an older release or a local binary.
LIBREPAPER_VERSION=

# Compose and proxy settings. The matching app origins live in config.toml.
DOMAIN=paper.example
# DOCS_DOMAIN=docs.paper.example
ACME_EMAIL=you@example.org

# Generate once and keep: `openssl rand -hex 24` (hex, because it goes inside a
# postgresql:// URL where base64's `/` would break it). Changing it after the
# first start requires an ALTER ROLE against the existing cluster.
POSTGRES_PASSWORD=

# A separate read-only-with-respect-to-application-data account for aggregate
# PostgreSQL monitoring. Used only by the postgres exporter.
POSTGRES_EXPORTER_PASSWORD=

# Grafana's local administrator account. Use a long random hex value, for
# example `openssl rand -hex 32`; changing this value after first startup does
# not rotate the password in Grafana's database (see README).
GRAFANA_ADMIN_PASSWORD=

# Optional config-referenced OAuth values. To enable a provider, set both
# values and uncomment its [auth.*] table in config.toml. Empty values fail
# config loading. GitHub callback: https://$DOMAIN/auth/callback; Google:
# https://$DOMAIN/auth/callback/google.
# LIBREPAPER_GITHUB_CLIENT_ID=
# LIBREPAPER_GITHUB_CLIENT_SECRET=
# LIBREPAPER_GOOGLE_CLIENT_ID=
# LIBREPAPER_GOOGLE_CLIENT_SECRET=
