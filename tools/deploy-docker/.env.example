# Copy to .env beside compose.yaml. Values are read by docker compose, so write
# them bare, with no surrounding quotes.

# The release tag for the normal Dockerfile path. It requires a metrics-capable
# v0.0.9 or later release; v0.0.8 has no metrics endpoint. Until then, use the
# local binary and compose.local.yaml as described in README.md.
LIBREPAPER_VERSION=

# The reader's public name, and the documents' (DOCS_DOMAIN defaults to
# docs.<DOMAIN>; set it to use another host, which must differ from DOMAIN).
# Both need a DNS record pointing at this host before the first `up`: the
# proxy gets a certificate for each of them over HTTP-01.
DOMAIN=paper.example
# DOCS_DOMAIN=docs.paper.example
ACME_EMAIL=you@example.org

# Generate once and keep: `openssl rand -hex 24` (hex, because it goes inside a
# postgresql:// URL where base64's `/` would break it). Changing it after the
# first start requires an ALTER ROLE against the existing cluster.
POSTGRES_PASSWORD=

# A separate read-only-with-respect-to-application-data account for aggregate
# PostgreSQL monitoring. Used only by the postgres exporter.
POSTGRES_EXPORTER_PASSWORD=

# Who may publish, and who may comment. A GitHub login, a Google account's
# verified address, a whole @domain of them, a comma-separated list, or `any`
# signed-in account. `anyone` is for commenting only.
LIBREPAPER_PUBLISHERS=
LIBREPAPER_COMMENTERS=anyone

# Per-publisher admission limits (MB uses LibrePaper's binary MiB convention).
# Defaults are 50 MB retained storage and 30 uploads per hour.
# LIBREPAPER_QUOTA=50
# LIBREPAPER_UPLOADS_PER_HOUR=30

# Grafana's local administrator account. Use a long random hex value, for
# example `openssl rand -hex 32`; changing this value after first startup does
# not rotate the password in Grafana's database (see README).
LIBREPAPER_ADMIN_PASSWORD=

# Private app metrics listener. Prometheus reaches it over Compose's internal
# network; this port is never published on the host.
LIBREPAPER_METRICS_ADDR=0.0.0.0:9091

# At least one OAuth client, unless nobody is ever asked to sign in. The two
# GitHub URLs are https://$DOMAIN and https://$DOMAIN/auth/callback; Google's
# redirect URI is https://$DOMAIN/auth/callback/google. Uncomment the pair you
# use. Set both the ID and secret for the provider you choose; an empty value
# is still a value, and the server would take it for a real credential.
# LIBREPAPER_GITHUB_CLIENT_ID=
# LIBREPAPER_GITHUB_CLIENT_SECRET=
# LIBREPAPER_GOOGLE_CLIENT_ID=
# LIBREPAPER_GOOGLE_CLIENT_SECRET=

# Optional. A deployment anybody may publish to should set a lifetime; one
# whose publishers you know should not.
# LIBREPAPER_EXPIRE_AFTER=30d
# LIBREPAPER_BUDGET_TRANSFER=10GiB
