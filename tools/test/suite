#!/usr/bin/env bash
# The rarer test suites, kept out of the everyday `make test` and `make check`.
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$root"

BIN=dist/librepaper
SHELL_OUT=web/dist/index.html

usage() {
	cat <<'USAGE'
usage: tools/test/suite <suite>

  backup      backup, encrypt, restore and replay-verify a synthetic deployment (needs docker, age, age-keygen)
  browser     component tests in headless Chromium (needs chromium; set LIBREPAPER_CHROMIUM to override)
  smoke       drive the reader in headless Chromium (needs chromium; set LIBREPAPER_CHROMIUM to override)
  external    Quarto/R/Python and real local-service integration tests
  fuzz        every fuzz target for FUZZ_SECONDS (default 60) each
              (FUZZ_TARGETS overrides the target list; needs nightly and cargo-fuzz)
  help        this text
USAGE
}

require_chromium() {
	local executable
	if ! executable="$(node web/tools/browser-executable.mjs --print)"; then
		echo "the requested browser suite needs Chromium; install it or set LIBREPAPER_CHROMIUM to an executable path" >&2
		return 1
	fi
	export LIBREPAPER_CHROMIUM="$executable"
}

# The component tests. Each builds its own bundle from web/src and drives a
# headless chromium. The per-test bound is generous: the LaTeX one drives a
# real TeX Live and takes minutes by itself.
suite_browser() {
	require_chromium
	# This suite is deliberately Chromium-only. A few direct test entry points
	# can select Firefox for standalone runs; do not let inherited selectors
	# override the browser prerequisite and resolver used here.
	export BROWSER=chromium
	tools/assets/pins fetch
	local failed="" test log
	local -a test_args=()
	for test in web/tests/browser/*.mjs; do
		printf '%s: ' "$(basename "$test")"
		test_args=()
		if [ "$(basename "$test")" = "latex-browser.mjs" ]; then
			test_args=(chromium)
		fi
		log="$(mktemp "${TMPDIR:-/tmp}/librepaper-browser-test.XXXXXX")"
		if (cd web && timeout 900 node "../$test" "${test_args[@]}" >"$log" 2>&1); then
			echo ok
		else
			echo FAILED
			failed="$failed $(basename "$test")"
			sed 's/^/    /' "$log" | tail -40
		fi
		rm -f "$log"
	done
	[ -z "$failed" ] || { echo "failed:$failed"; return 1; }
}

# The rendered reader. Needs the built binary and a chromium, and starts a
# server of its own on a temporary directory and a throwaway database, so it
# also needs LIBREPAPER_TEST_POSTGRES_URL.
suite_smoke() {
	require_chromium
	make --no-print-directory "$BIN"
	bun web/tools/browser-smoke.mjs "$BIN"
}

suite_external() {
	cargo test -p librepaper-companion quarto -- --ignored --nocapture --test-threads=1 \
		--skip quarto_project_scope_collects_pages_and_nested_web_resources \
		--skip quarto_book_scope_keeps_chapter_navigation
}

# libFuzzer over the functions that read what somebody else wrote. A finding is
# left in tools/test/fuzz/artifacts/. No sanitizer: the code under test is safe Rust.
suite_fuzz() {
	tools/assets/pins fetch
	make --no-print-directory "$SHELL_OUT"
	command -v cargo-fuzz >/dev/null || { echo "cargo-fuzz is not installed: cargo install cargo-fuzz"; return 1; }
	local seconds="${FUZZ_SECONDS:-60}" targets target
	targets="${FUZZ_TARGETS:-$(cargo fuzz list --fuzz-dir tools/test/fuzz)}"
	for target in $targets; do
		echo "fuzzing $target for ${seconds}s"
		cargo fuzz run --fuzz-dir tools/test/fuzz -s none "$target" -- -max_total_time="$seconds" || return 1
	done
}

# Verify backup, encryption, restore and replay of a synthetic deployment.
# Creates a temporary PostgreSQL instance, a key pair, all supporting files,
# and verifies that a backup taken by `admin backup`, encrypted with age,
# and restored by `admin restore` reproduces every byte of the source database
# and every labeled frontier in application replay. All containers and files
# are cleaned up at exit.
suite_backup() {
	command -v docker >/dev/null || { echo 'docker is required'; return 1; }
	command -v age >/dev/null || { echo 'age is required'; return 1; }
	command -v age-keygen >/dev/null || { echo 'age-keygen is required'; return 1; }
	command -v node >/dev/null || { echo 'node is required'; return 1; }
	command -v tar >/dev/null || { echo 'tar is required'; return 1; }
	make --no-print-directory "$BIN"
	local scratch work container port
	scratch=$(mktemp -d "${TMPDIR:-/tmp}/librepaper-backup-suite.XXXXXX")
	work=$(mktemp -d /tmp/librepaper-backup-drill.XXXXXX)
	container="librepaper-backup-drill-$$"
	port=$(node -e 'const s=require("net").createServer().listen(0,"127.0.0.1",()=>{console.log(s.address().port);s.close()})')
	# Expanded now: the locals are gone by the time an EXIT trap runs.
	# shellcheck disable=SC2064
	trap "docker rm -f '$container' >/dev/null 2>&1 || true; rm -rf '$scratch' '$work'" EXIT
	docker run -d --rm --name "$container" -e POSTGRES_PASSWORD=drill -p "127.0.0.1:$port:5432" postgres:17.11-alpine >/dev/null
	local ready=0 i
	for (( i=0; i<60; i++ )); do
		if docker exec "$container" pg_isready -U postgres -q; then
			ready=1
			break
		fi
		sleep 1
	done
	[[ "$ready" == 1 ]] || { echo 'PostgreSQL failed to start'; return 1; }
	docker exec "$container" psql -U postgres -qc 'CREATE DATABASE drill_source' -c 'CREATE DATABASE drill_restored'
	mkdir -p "$scratch/bin"
	for tool in psql pg_dump pg_restore; do
		ln -sf "$root/tools/test/backup/postgres-tool.sh" "$scratch/bin/$tool"
	done
	export PATH="$scratch/bin:$PATH"
	age-keygen -o "$scratch/identity.txt" 2>/dev/null
	local recipient
	recipient=$(age-keygen -y "$scratch/identity.txt")
	LIBREPAPER_BIN="$root/$BIN" \
	LIBREPAPER_SOURCE_URL="postgresql://postgres:drill@127.0.0.1:$port/drill_source" \
	LIBREPAPER_RESTORE_URL="postgresql://postgres:drill@127.0.0.1:$port/drill_restored" \
	AGE_RECIPIENT="$recipient" \
	AGE_IDENTITY="$scratch/identity.txt" \
	BACKUP_DRILL_DIR="$work" \
	BACKUP_DRILL_KEEP=1 \
	tools/test/backup/drill.sh
	BACKUP_DRILL_SOURCE_URL="postgresql://postgres:drill@127.0.0.1:$port/drill_source" \
	BACKUP_DRILL_RESTORE_URL="postgresql://postgres:drill@127.0.0.1:$port/drill_restored" \
	BACKUP_DRILL_SOURCE_DATA="$work/source-data" \
	BACKUP_DRILL_RESTORE_DATA="$work/restored-data" \
	cargo test --release -p librepaper --test backup_drill_verify -- --ignored --nocapture
}

case "${1:-help}" in
	backup) suite_backup ;;
	browser) suite_browser ;;
	smoke) suite_smoke ;;
	external) suite_external ;;
	fuzz) suite_fuzz ;;
	help | -h | --help) usage ;;
	*) usage >&2; exit 2 ;;
esac
