#!/usr/bin/env bash
# Pinned external inputs: the browser wasm modules (assets.lock) and the
# loro-codemirror binding (web/loro-codemirror.lock).
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

usage() {
	cat <<'USAGE'
usage: tools/pins <command>

  fetch                        fetch and verify the browser wasm modules and the
                               loro-codemirror binding (writes nothing that does
                               not match a lock)
  update wasm <repo> <tag>     move one renderer pin, e.g. wasm-markdown vX.Y.Z
  update loro <commit>         move the binding pin to a full 40-char sha
  update latex [mirror-dir]    pin the one release in ../wasm-latex/mirror
  help, -h, --help             show this message
USAGE
}

case "${1:-help}" in
	fetch)
		node web/tools/fetch-modules.mjs
		node web/tools/fetch-loro-codemirror.mjs
		;;
	update)
		case "${2:-}" in
			wasm)
				if [ -z "${3:-}" ] || [ -z "${4:-}" ]; then
					echo 'usage: tools/pins update wasm <repo> <tag>  (e.g. wasm-markdown vX.Y.Z)' >&2
					exit 2
				fi
				node web/tools/update-module-pin.mjs --repo "$3" --tag "$4"
				;;
			loro)
				if [ -z "${3:-}" ]; then
					echo 'usage: tools/pins update loro <full 40-char sha>' >&2
					exit 1
				fi
				node web/tools/update-loro-codemirror.mjs "$3"
				;;
			latex)
				node web/tools/update-latex-pin.mjs "${3:-../wasm-latex/mirror}"
				;;
			*)
				usage >&2
				exit 2
				;;
		esac
		;;
	help | -h | --help)
		usage
		;;
	*)
		usage >&2
		exit 2
		;;
esac
